#ifndef H_VDO_0x09_INC_INCLUDED
#define H_VDO_0x09_INC_INCLUDED

#include "vdo_inc.bt"


typedef struct{
local WORD  i <hidden=true>;
local WORD  sq_size, map_files_cnt=0;
local FLOAT degrees_in_unit=1.1; // <hidden=true>;
local float deg_size;

//header start
    BL_HEADER       block;
// header end, last = 0Ch -1 



}BLOCK_TYPE_0x08 < read=Read_BLOCK_TYPE_0x09, 
    comment=Comment_block0x09 >;
string Comment_block0x09(BLOCK_TYPE_0x09 &a){
    return Comment_BL_ADDR(a.block.addr);
}
string Read_BLOCK_TYPE_0x09(BLOCK_TYPE_0x09 &a){
    local string s;
    SPrintf(s, "%i of %i; %ix%i;   Size: %f degr", a.map_files_cnt,  
        a.block.data.Cnt, a.sq_size, a.sq_size, a.deg_size);
    return s;
}


#endif //H_VDO_0x09_INC_INCLUDED