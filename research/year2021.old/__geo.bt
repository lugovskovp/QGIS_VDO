// GEO_TYPE
typedef struct{
    //local DWORD         p_gt_tptr <hidden=true>;
    local DWORD         size_place <hidden=true>;
    local WORD          obj_cnt <format = hex> = 0;
    en_GEO_OBJ_TYPE     type;
    en_MAP_SHAPE_TYPE   is_line;
    PTR                 p_type_obj;
    local PTR           p_next_type_obj;

    // calc obj count
    if(type != 0){
        p_next_type_obj.Ptr = ReadUShort(FTell()+2);
        if(is_line){
            obj_cnt = ( p_next_type_obj.Ptr - p_type_obj.Ptr ) / 10h;
        }else{
            obj_cnt = ( p_next_type_obj.Ptr - p_type_obj.Ptr ) / 14h;
        }
    }else{
    // this is last - tail
    // obj_cnt = 0;
    }

//obj_cnt = ReadUShort(p_type_obj.offset+2);
/*
    // is this element not last in list?
    if(type != 0){
        // FTell - begin next type
        size_place = ReadUShort(FTell()+2) - p_type_obj.Ptr;
        p_gt_tptr = FTell();
        FSeek(p_type_obj.offset);
        if(is_line){
            obj_cnt = size_place / 10h;
            GEO_PLINE object[obj_cnt]<optimize=true>;
        }else{
            obj_cnt = size_place / 14h;
            GEO_SHAPE object[obj_cnt] <optimize=true>;
        }
        FSeek(p_gt_tptr);
    }else{
    // this is last - tail
    // obj_cnt = 0;
    }
*/
}GEO_TYPE<read=Read_GEO_TYPE>;
string Read_GEO_TYPE(GEO_TYPE &a){
    local string s="", temp_s="sttart_valu";// = Read_GEO_SHAPE(a.object[0]);
    local unsigned byte cnt_list = 0;
    local WORD i=0;
    if(a.type != 0){
        SPrintf(s,"0x%02X%02X %s;\t[%02i]: \t\t%s", a.type, a.is_line, 
            EnumToString(a.type), a.obj_cnt, s);
    }else{
        s = "_tail_";
    }
    return s;
};

// C_GEO_TYPE - compressed
typedef struct{
    //local DWORD         p_gt_tptr <hidden=true>;
    local DWORD         size_place <hidden=true>;
    local WORD          obj_cnt <format = hex> = 0;
    en_GEO_OBJ_TYPE     type;
    en_MAP_SHAPE_TYPE   is_line;
    local PTR           p_type_obj;
    local PTR           p_next_type_obj;

    // calc obj count
    if(type != 0){
        if(is_line){
            obj_cnt = ( p_next_type_obj.Ptr - p_type_obj.Ptr ) / 10h;
        }else{
            obj_cnt = ( p_next_type_obj.Ptr - p_type_obj.Ptr ) / 14h;
        }
    }else{
    // this is last - tail
    // obj_cnt = 0;
    }
}C_GEO_TYPE<read=Read_C_GEO_TYPE>;
string Read_C_GEO_TYPE(C_GEO_TYPE &a){
    local string s="", temp_s="sttart_valu";// = Read_GEO_SHAPE(a.object[0]);
    local unsigned byte cnt_list = 0;
    local WORD i=0;
    if(a.type != 0){
        SPrintf(s,"0x%02X%02X %s;\t[%02i]: \t\t%04X-%04X", a.type, a.is_line, 
            EnumToString(a.type), a.obj_cnt, a.p_type_obj.Ptr, a.p_next_type_obj.Ptr);
    }else{
        s = "_tail_";
    }
    return s;
};


