//{GEO_SHAPE
typedef struct{
    local DWORD p_gs_tptr <hidden=true>;
    local WORD  vertex_cnt;
    local DWORD  offset = FTell();
    local en_GEO_OBJ_TYPE     type; //need fill after create
    local string name = "";
    PTR         p_str_name <bgcolor=cGreen>;
    PTR         p_vertexes_obj;   
    DWORD       id<format=hex, fgcolor=cBlue, bgcolor=cLtYellow>;
    LON_LAT     coord;
ZERO_WORD   aligment;
    PTR         p_table_name <bgcolor=cLtGreen>;
//
// name /0-ended string
    if (p_str_name.Ptr !=0 ){name = ReadString(p_str_name.offset);}

    // only valid objects, id>0
    if(id){
        if(p_vertexes_obj.Ptr){
            p_gs_tptr = FTell();
            FSeek(FTell()+2); // for bl_type_0x1c
                PTR p_vertexes_next_obj <format=hex>;
                //local DWORD offset_vertexes_next_obj  <format=hex>
                //            = p_vertexes_next_obj + block.offset;
            FSeek(p_vertexes_obj.offset);
            vertex_cnt = (p_vertexes_next_obj.offset - p_vertexes_obj.offset) / 4;
            struct{
                DWORD vertx [vertex_cnt] <optimize = true>;
            }vertexes;

            FSeek(p_gs_tptr);
        }
    }
}GEO_SHAPE <read=Read_GEO_SHAPE>;
string Read_GEO_SHAPE(GEO_SHAPE &a){
    local string s="";
    SPrintf(s,"%s '%s'\t[%i];  ", EnumToString(a.type), a.name,  a.vertex_cnt);
    return s;
};
