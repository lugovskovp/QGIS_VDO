//GEO_VERTEX
typedef struct{
    WORD x;
    WORD y;
}GEO_VERTEX <read=Read_GEO_VERTEX, bgcolor=cLtBlue, fgcolor=cYellow>;
string Read_GEO_VERTEX(GEO_VERTEX &a){
    string s;
    SPrintf(s, "%04X %04X", a.x, a.y);
    return s;
}


// --- LON_LAT      - DWORD  = DWORD hex longtityde / 0x54C56D - 30;
//                              | DWORD hex latatude
typedef struct{
//DWORD   hlat <hidden=true>, hlon <hidden=true>;
//Longitude - dolgota  0 - 180 E/W kld: 20e
//latitude - shirota 0 - 90° N/S kld: 55n
int   hlon <format=hex, fgcolor=cLtGreen, bgcolor=cDkAqua>;
int   hlat  <format=hex, fgcolor=cLtGray, bgcolor=cDkAqua>;
    //coordinates
    local double lo=10.0f, la=10.0f;
        //la = hlat2double(hlat);
        //lo = hlon2double(hlon);
        lo = 1.0f * hlon / 0x54C56D - 30;
        la = 1.0f * hlat / 0x54C56D;
        //la = la % 360.0;
        //lo = lo % 360.0;
}LON_LAT <read=Read_LON_LAT>;
string Read_LON_LAT(LON_LAT &a) {
    local string s;
    SPrintf( s, "%06f %s, %06f %s", 
    Abs(a.la), (a.la>0)?"N":"S",
    Abs(a.lo), ((a.lo>=0)?"E":"W") );
    return s;
}

DWORD double2hlat(double &lat){
    //lat = lat % 360.0;  //   Printf("\n%lf.0 lat\n", lat);
    return (lat * 0x54C56D);
}
double hlat2double(DWORD hlat){
    local double lat = 10.0f;
//Printf("%d\n", lat);
    lat = 1.0f * hlat / 0x54C56D;
    //lat = lat % 360.0;
    return lat;
}
DWORD double2hlon(double lon){
    //lon = lon % 360.0;
    return ((lon + 30.0) * 0x54C56D);
}
double hlon2double(DWORD hlon){
    local double lon = ((1.0f * hlon )/ 0x54C56D) - 30.0;
    //lon = lon % 360.0;
    return lon;
}

//geo_area
typedef struct{
    local DWORD h_size <format=hex, hidden=false>;
    local DWORD v_size <format=hex>;
    local DWORD scale <format=hex>;
    LON_LAT     bottom_left, top_right;
    h_size = top_right.hlon - bottom_left.hlon;
    v_size = top_right.hlat - bottom_left.hlat;
    scale = h_size / 0xA000;    // ?????????? sure? allways??? 1d, 03, ect
}geo_area<read=ReadGeoArea>;
string ReadGeoArea(geo_area &a){
    string s;
    SPrintf(s, "area [%04Xx%04X]h scale 0x%04X", a.h_size, a.v_size, a.scale);
    return s;
}



//GEO_OBJ_STR
typedef struct{
    //local DWORD t_ptr <hidden=true> = FTell();
    PTR p_str_name  <bgcolor=cLtGreen>;
    en_GEO_OBJ_STR type; 

    local DWORD t_g_ptr<hidden=true>;
    if(p_str_name.Ptr){
        t_g_ptr = FTell();
        FSeek(p_str_name.offset);
            string name <bgcolor=cLtGreen>;
        FSeek(t_g_ptr);
    }else{
        local string name="";
    }
}GEO_OBJ_STR<read=Read_GEO_OBJ_STR>;
string Read_GEO_OBJ_STR(GEO_OBJ_STR &a){
    local string s;
    SPrintf(s, "%04X %s - %s", a.type,
        EnumToString(a.type), a.name);
    return s;
}

// GEO_PLINE see GEO_SHAPE
typedef struct{
    local string name = "";
    local en_GEO_OBJ_TYPE     type; //need fill after create
    local DWORD  offset = FTell();
    local DWORD p_gs_tptr <hidden=true>;
    PTR         p_str_name <bgcolor=cGreen>;
    PTR         p_vertexes_obj;
        local WORD vertex_cnt <format=hex> = 0;
            // ReadUInt(FTell() = 0 in last
        if( ReadUInt( FTell() ) ) vertex_cnt = (ReadUShort(FTell()+0eh) - p_vertexes_obj.Ptr )/4;
    DWORD       id<format=hex, fgcolor=cBlue, bgcolor=cLtYellow>;
    // LON_LAT     THIS_NOT_coord; // THIS_NOT_coord    bl_offset( 0x293B9000 );
    PTR   p_line_sign; // Or start pstr
    WORD  b_or_c; 
    PTR   p_p_str_name; // ptr to GEO_OBJ_STR
    WORD   or_38_or_0_b_country;

    local string pline_name;
//
// name 
    if (p_str_name.Ptr){name = ReadString(p_str_name.offset);}
// vertexes
    // only valid objects, id>0
    if(id){
        if(p_vertexes_obj.Ptr){
            p_gs_tptr = FTell();
            FSeek(p_vertexes_obj.offset);
            struct{
                DWORD vertx [vertex_cnt] <optimize = true>;
            }vertexes;
            FSeek(p_gs_tptr);
        }
        if(p_p_str_name.Ptr){
            p_gs_tptr = FTell();
            FSeek(p_p_str_name.offset);
                GEO_OBJ_STR p_line_name;
                pline_name = p_line_name.name;
            FSeek(p_gs_tptr);
        }
    }
}GEO_PLINE <read=Read_GEO_PLINE>;
string Read_GEO_PLINE(GEO_PLINE &a){
    local string s="";
    //SPrintf(s,"0x%02X%02X %s \t%s", a.type, a.is_line, EnumToString(a.type), s);
    SPrintf(s,"%s [%i]\t '%s' \"%s\"",  EnumToString(a.type), a.vertex_cnt, a.name, a.pline_name );
    return s;
};

