#include "vdo_inc.bt"
/*

GEO

SYMBOL          3*DWORD = BL_ADDR | char Symbol |0/1 - type - symbol or texst 
                        | PTR_CNT - array in BL_ADDR of this symbols

PTR_string      




*/


// --- GEO
// main data of 0A,c,e,10.
typedef struct{
//rec start
    PTR              p_str_name <bgcolor=cLtGreen>;
    en_GEO_TYPE      type_obj      <format=hex,bgcolor=cLtBlue>;
    en_CARINET_LANGUAGE     en_language;
    local WORD cptr <hidden=true> = ReadUShort(FTell()); //ptr bgcolor
    if(cptr){
        PTR    p_str_parent_name <bgcolor=cLtGreen>;
    }else{
        PTR    p_str_parent_name <hidden=true, bgcolor=cLtGray, fgcolor=cWhite>;
    }
        PTR    p_geo_info <fgcolor=cDkGreen, bgcolor=0x008CFF>;
local DWORD offset_info = p_geo_info.offset;
//rec end
// data on ptr`s
    //
    local DWORD l_geo_tmp <hidden=true> = FTell();
    FSeek(p_str_name.offset);
        string name <bgcolor=cGreen>;
    //
    if(p_str_parent_name.Ptr){
        FSeek(p_str_parent_name.offset);
        string parent_name <bgcolor=cLtGreen>;
    }else{
        local string parent_name = "";
    }
    FSeek(l_geo_tmp);
}GEO <read = Read_GEO>; //,  comment=Comment_GEO_PLACE>;
string Read_GEO(GEO &a){
    local string s;
    //SPrintf(s, "%02X %02X : (%s) %s [%s, %s]",  
    //         a.type_obj, a.en_language, a.parent_name, a.name,
    //         EnumToString(a.en_language), EnumToString(a.type_obj)   );
    SPrintf(s, "%s (%s) lang: %s, %s",  
              a.name, a.parent_name,
             EnumToString(a.en_language), EnumToString(a.type_obj)   );
    return s;
}

// --- SYMBOL          3*DWORD = BL_ADDR | char Symbol |0/1 - type - symbol or texst 
//                      | PTR_CNT - array in BL_ADDR of this symbols

// SYMBOL used in 0B 0A
typedef struct  {
    BL_ADDR     bl_addr<bgcolor=cRed>;// <hidden=true>;
    char        ch <bgcolor=cLtGreen>;   //char - start name of country
//  type=1 - strings - get interface str list for choice 
//  type=0 - symbols - get keyboard with list accesible chars - char idx ( 0Dh,
    en_interface_choice_type    type_intf;  
    if ((type_intf != 1) && (type_intf != 0)) {
            return;//eerror - not 1|0
    }
    PTR_CNT     symbols_array;// <hidden=true>;
    WORD   aligment <fgcolor=cWhite, bgcolor=cLtGray, hidden=true>;   // ob, od = 0
    local DWORD far_offset <format=hex> = bl_addr.offset + symbols_array.Ptr;
// fill data
    local DWORD t_ptr = FTell();
    switch(type_intf){
        case 0:
            FSeek(far_offset);
                //struct SYMBOL items[symbols_array.Cnt]<optimize=false, size=8>;
            break;
        case 1:
            FSeek(far_offset);
                GEO far_items[symbols_array.Cnt]<optimize=false, size=8>;
            break;
        default:
            return; // ERR happend - not 1||0
    }
    FSeek(t_ptr);
        
//}SYMBOL < read=Read_SYMBOL, size=12, bgcolor=cAqua>;
}SYMBOL < read=Read_SYMBOL, bgcolor=cAqua>;
string Read_SYMBOL(SYMBOL &a){
    string s="";
    WORD i;
    SPrintf(s, "'%s' [%i] |",  a.ch, a.symbols_array.Cnt);
    if(a.type_intf == 0){
        for(i=0; i<a.symbols_array.Cnt; i++){
            SPrintf (s, "%s %s", s , 
                ReadByte( a.far_offset + i*12 + 4 ));
        }
        SPrintf(s, "%s |", s);
    }
    if(a.type_intf == 1){
        for(i=0; i<a.symbols_array.Cnt; i++){
            SPrintf(s, "%s %s |", s,
               ReadString( a.bl_addr.offset +  
                //ReadUShort(a.str_block.offset + i*8 + a.in_str_block.Ptr) ) );
                ReadUShort(a.far_offset + i*8 ) ) );
        }
    }
    return s;
};




//



typedef struct {
    PTR p_str <bgcolor=cLtGreen>;   
    if(p_str.Ptr){
        local DWORD tptr <hidden=true> = FTell();
        FSeek(p_str.offset);
            string str;
        FSeek(tptr);
    }else{
        local string str = "";
    }
}PTR_string <read=Read_PTR_string, optimize=false>;
string Read_PTR_string(PTR_string &a){
    //local string s;
    return a.str;
}
