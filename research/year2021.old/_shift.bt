//97B61C53E5780 [e29 - e3x - e49]
void do_shape(void){

/*
// shape
2h  - ptr2str/0; 
2h - ptr2vertexes (first=first vert)
4h - id [0000 7685]
8h - LON_LAT
2h = 00 00 - aligment
2h - ptr2 list strPtr

597E81E43C8F61CE
*/
local byte prev_sh, sh_str, sh_vert, sh_id, sh_la, sh_lo;
sh_str  =   10;     sh_vert =   5;  sh_id   =   0;
sh_str  =   4;     sh_vert =   2;  sh_id   =   4;   sh_la   = 0;    sh_lo   = 0;

sh_str  =   4;     sh_vert =   1;  sh_id   =   12;
sh_str  =   4;     sh_vert =   2;  sh_id   =   11;
//sh_str  =   1;     sh_vert =   6;  sh_id   =   8;       do_shift(0, 8);


sh_la = 0;    sh_lo = 0;

sh_str = 4;    sh_vert = 3;   sh_id = 2;   sh_la = 0;    sh_lo = 0;

sh_str = 4;    sh_vert = 2;   sh_id = 4;    // 05 00 08 00 Shape data len = 64+54, sh_len=10, akk_sh=6 .
//prev_sh = 24; sh_str = 4;    sh_vert = 0;   sh_id = 12;    // 05 15 07 00 
//-----------------------------------
prev_sh = 0; sh_la = 0;    sh_lo = 0;


sh_str = 4;    sh_vert = 2;   sh_id = 9;     // 05 00 08 00 | 5<<2=14, all




Printf("\n\nShape data len = 64+%i, sh_len=%i, akk_sh=%i .\n", 
    (16-sh_str) + (16-sh_vert) + (32-sh_id),// + (64 - sh_la - sh_lo),
    sh_str + sh_vert + sh_id + sh_la + sh_lo,
    akk_shift );
        Print_buf(buff);

// shift before
//do_shift(0, 8);
/*
Printf("\n     %04X <<prev(%i) \t", do_shift(0, prev_sh), prev_sh );  //addr_sh=0 - 4,16/ 0
        Print_buf(buff);
*/
// 4 0
Printf("\n  %04X -str(%i) \t", do_shift(sh_str, 16), sh_str );  //addr_sh=0 - 4,16/ 0
        Print_buf(buff);
Printf("\n  %04X -vertex(%i) \t", ( do_shift(sh_vert, 16))>>2, sh_vert );  //addr_sh=0 - 1,16
        Print_buf(buff);
Printf("\n  %08X -id(%i) \t", do_shift(sh_id, 32), sh_id );  //addr_sh=0 - 5, 32  E97730A1C7DF79E0
        Print_buf(buff);
Printf("\n   %08X -LAT(%i)  \t", do_shift(sh_la, 32), sh_la );  //addr_sh=0 - 0,32
        Print_buf(buff);
Printf("\n   %08X -LON(%i)  \t", do_shift(sh_lo, 32), sh_lo );  //addr_sh=0 - 0,32
        Print_buf(buff);
//2h = 00 00 - aligment
Printf("\n  %04X <-0000 ", do_shift(16, 16) );  //addr_sh=0 - 0,32
        Print_buf(buff);
//2h - ptr2 list strPtr
Printf("\n  %04X  ", do_shift(16, 16) );  //addr_sh=0 - 0,32
        Print_buf(buff);


}

//-================================
DWORD do_shift(WORD sh_bits, DWORD bits_qty){
    local DWORD val;
    // global QUAD buff, DWORD ptr
    buff >>=sh_bits;
    val = buff >> (64 - (bits_qty ) );
    buff <<= (bits_qty ) ;
    do_fill_end_buff(bits_qty - sh_bits);
    return val;
}


void do_t(void){
    Print_buf(buff); Printf(" = %02X", buff>>(64-7) );
    buff <<=7;
     sh = 7;  buff >>= sh; Printf(" %02X =", buff>>(64-8) );
    //Print_buf(buff); 
    buff <<=8;  Print_buf(buff); 
    //addr 
/*
0 >>1, r12<<1
1 r12 <<1
2 r12 <<2
*/

if (!addr_sh ){
    buff >>=1;
    Printf(" | %03X <<%i = %04X = ", (buff>>(64-12)), addr_sh+1, (buff>>(64-12))<<(addr_sh+1) );
    buff <<=1;
}else{
    Printf(" | %03X <<%i = %04X = ", (buff>>(64-12)), addr_sh, (buff>>(64-12))<<(addr_sh) );
}

buff <<=11+addr_sh;

     Print_buf(buff);  
    
     do_fill_buff(11+8+addr_sh);

//Printf("\n");

}

// load more buffer
void do_fill_buff(WORD bits_qty){
    local unsigned QUAD  buf_t<format=hex>;
    // use global DWORD ptr, WORD akk_shift
    Printf ("\n  b:%i a:%i, -%i-", bits_qty, akk_shift, 
        ( (bits_qty+akk_shift) >>3 ) );
    // increase pointer
    ptr+= ( (bits_qty+akk_shift) >>3 ); // divide by 3
    Printf ("\n  ptr=%X\n", ptr);

//     Printf ("\n  a: %i %i, -%i-", akk_shift, bits_qty, ( (bits_qty+akk_shift) >>3 ) );


// akk_shift - akkumulated
    akk_shift = (bits_qty+akk_shift) - (((bits_qty+akk_shift)>>3)<<3);     

    buf_t = ReadUQuad(ptr);
     Print_buf(buf_t);
    buf_t <<= akk_shift;
     Print_buf(buf_t);
    buff |= buf_t;
     Printf("\n");

}






//-------------------------------------------
void Print_buf(QUAD b){
    Printf(" %08X %08X ", b >>32, b & 0xffffffff);
}

void do_decode(DWORD ptr_block_begin){
    
    local DWORD off_start_compr<format=hex> = ptr_block_begin + 38h;
    local DWORD ptr<format=hex> = off_start_compr;
    local WORD i;   //counter
    // extern global QUAD buffer, WORD 

// decode headers
    bl_offset( ptr_block_begin );

//calc addr_sh
    ptr = off_start_compr;
    buff = ReadUQuad(off_start_compr);
    // local unsigned QUAD  buff<format=hex>, buf_t<format=hex>;

    addr_sh = 0; buff_sh = 0;   // 19 bits len compressed type
    if ( ((buff>> (64-20) & 0xff ))<<1 == 
                ReadUShort (ptr_block_begin +0x0c) ) addr_sh = 1;    // 20
    if ( ((buff>> (64-20) & 0xff ))<<2 == 
                ReadUShort (ptr_block_begin +0x0c) ) addr_sh = 2;    // 21

Printf(" calc addr_sh: -- %04X <<  %i = %04X\n", 
        buff>> (64-20) & 0xff , addr_sh, ReadUShort (ptr_block_begin+0x0c) );

    //ptr = off_start_compr;
    //buff = ReadUQuad(ptr);

Printf(" types: %04X\n\n", ReadUShort(ptr_block_begin + 0xa) );
/*
Print_buf(buff); 
Printf(" %02i %08X \n", i,  decode_type());
*/

    for (i=0; i<= ReadUShort(ptr_block_begin + 0xa); i++){
        //local DWORD value = decode_type();
        Printf(" #%02i %08X \n", i,  decode_type());
    }
;
Printf(" buffer:"); Print_buf(buff); 
    // color uncompressed bytes with geo_types 
    //FSeek();
    // return WORD end_ptr;
}

DWORD decode_type(void){
    // extern global QUAD buffer
    local DWORD val<format=hex> =0;
    //type
    val = ( buff>>(64-7) ) <<24;    //type
    buff <<=7;
    buff >>=7;
    val |= ( buff>>(64-8) )<<16;    // 0- shape, 1 - poliline
    buff <<=8;
    //addr 
/*
0 >>1, r12<<1
1 r12 <<1
2 r12 <<2
*/
    if (!addr_sh ){
        buff >>=1;
        //Printf(" | %03X <<%i = %04X = ", (buff>>(64-12)), addr_sh+1, (buff>>(64-12))<<(addr_sh+1) );
        val |= (buff>>(64-12))<<(addr_sh+1);
        buff <<=1;
    }else{
        //
//Printf(" | %03X <<%i = %04X = ", (buff>>(64-12)), addr_sh, (buff>>(64-12))<<(addr_sh) );
        val |= (buff>>(64-12))<<(addr_sh);
    }
    //Print_buf(buff);
    buff <<=11+addr_sh;
    //Print_buf(buff);      
     do_fill_end_buff(11+8+addr_sh);
//Printf("\n");   
    return val;
}



// load more buffer
void do_fill_end_buff(WORD bits_qty ){
    local unsigned QUAD  buf_t<format=hex>;
    
    // use global DWORD ptr, WORD akk_shift
    // increase pointer
    ptr+= ( (bits_qty+akk_shift) >>3 ); // divide by 3
    // akk_shift - akkumulated
    akk_shift = (bits_qty+akk_shift) - (((bits_qty+akk_shift)>>3)<<3);

//     Printf ("\n  a: %i %i, -%i-", akk_shift, bits_qty, ( (bits_qty+akk_shift) >>3 ) );
//     Printf ("\n  a: %i %i, -%i-", akk_shift, bits_qty, ( (bits_qty+akk_shift) >>3 ) );

    buf_t = ReadUQuad(ptr);
     //Print_buf(buf_t);
    buf_t <<= akk_shift;
     //Print_buf(buf_t);
    buff |= buf_t;
     //Printf("\n");
}



