void decompress_block(DWORD ptr_block_begin){
    // use extern global QUAD buff
    local DWORD off_start_compr<format=hex> = ptr_block_begin + 38h; 

    // decode headers
    bl_offset( ptr_block_begin );

    g_ptr = off_start_compr;
    buff = ReadUQuad(off_start_compr);    

    // decode list of types
    _uncompress_types(ptr_block_begin);

    //
    _uncompress_shapes(ptr_block_begin);
    //
    _uncompress_plines();


