//--------------------------------
string ShortToBinaryStr( WORD num, unsigned WORD qtyBits ){
    local string s = "";
    local unsigned WORD i=4;
    
    while(qtyBits--){
        if( !i-- ) {
            SPrintf(s, " %s", s);
            i=3;
        }
        SPrintf(s, "%s%s", (num & 1)? "1" : "0", s);
        num >>=1;
    }
    //for(i=0; i<qtyBit
    return s;
}

