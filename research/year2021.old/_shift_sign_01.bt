                2h - ptr2vertexes (first=first vert)
                4h - id [0000 7685]
                8h - LON_LAT
                2h = 00 00 - aligment
                2h - ptr2 list strPtr
                */
    // 053de701 - 
//start_ptr=0x29EF3800; //:01 1-0; [05000800] str(12,0) vrtx(13,0) id(30,0) sum=55 
    Printf("\n Shapes: %i \n", ReadUShort(ptr_block_begin + 0x0e));
//Print_buf(buff);
    
for(i=0; i<ReadUShort(ptr_block_begin + 0x0e); i++){
        //local struct compressed_shape c_shape;
    c_shape[i].pstr_name = get_bits(12,0);
        c_shape[i].p_vertex  = get_bits(12,0);
        c_shape[i].p_vertex += ReadUShort(start_ptr + 0x14)-2; /// ??? so strange, need check after VERTEX decompress
        c_shape[i].id = get_bits(31,0);
    c_shape[i].coord.hlon = get_bits(32,0);
    c_shape[i].coord.hlat = get_bits(32,0);
    c_shape[i].coord.lo = 1.0f * c_shape[0].coord.hlon / 0x54C56D - 30;
    c_shape[i].coord.la = 1.0f * c_shape[0].coord.hlat / 0x54C56D;
}
//Printf("\n 0000 :"); Print_buf(buff);
//decode_shape(c_shape[1]);   LAST TAILED SHAPE - ONLY PTR P_VERTEX
        //local struct compressed_shape c_shape;
    c_shape[i].pstr_name = get_bits(12,0);
    c_shape[i].p_vertex  = get_bits(12,0); //buff 0028000
    c_shape[i].p_vertex += ReadUShort(start_ptr + 0x14);
    c_shape[i].id = get_bits(31,0);
    c_shape[i].coord.hlon = 0; //get_bits(32,0);
    c_shape[i].coord.hlat = c_shape[1].coord.hlon;

//Printf("\n 0001 :"); Print_buf(buff);
Printf("\n");
for(i=0; i< ReadUShort(ptr_block_begin + 0x0e)+1; i++){
    Printf("[%04X] [%04X] [%08X] [%08X %08X] %fN, %fE [0000] [0910] \n",
        c_shape[i].pstr_name, c_shape[i].p_vertex, c_shape[i].id,
        c_shape[i].coord.hlat, c_shape[i].coord.hlon,
        c_shape[i].coord.la , c_shape[i].coord.lo 
        );
}

Printf("\n");
Print_buf(buff);
Printf("\n");

    //color compressed shapes Printf("g:%X\n", g_ptr);
    local WORD qty_bytes= g_ptr - compr_shape_start;
    byte SHAPES_COMPR[ qty_bytes ] <bgcolor=cDkGreen, fgcolor=cLtRed>; 
}


