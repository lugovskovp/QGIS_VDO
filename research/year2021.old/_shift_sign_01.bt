void _uncompress_plines(void){}


//--------------------------------------------
//void uncompress_types(DWORD ptr_block_begin){
void _uncompress_types(DWORD ptr_block_begin){
    // use extern global QUAD buff
    local unsigned byte i, addr_sh=0;  // 19 bits len compressed type

    //calc addr_sh
    if ( ((buff>> (64-20) & 0xff ))<<1 == 
                ReadUShort (ptr_block_begin +0x0c) ) addr_sh = 1;    // 20  bits len compressed type
    if ( ((buff>> (64-20) & 0xff ))<<2 == 
                ReadUShort (ptr_block_begin +0x0c) ) addr_sh = 2;    // 21  bits len compressed type
    Printf(" Types cnt: %04X\n", ReadUShort(ptr_block_begin + 0xa) );
    Printf(" \tcalc addr_sh:  %04X << %i = %04X\n", 
            buff>> (64-20) & 0xff , addr_sh, ReadUShort (ptr_block_begin+0x0c) );
    
    // uncompress types
    for (i=0; i<= ReadUShort(ptr_block_begin + 0xa); i++){
        //local DWORD value = decode_type();
        //Print_buf(buff);
        Printf(" #%02i %08X \n", i,  decode_type(addr_sh));
    }

    // color compressed bytes with geo_types 
    FSeek(ptr_block_begin + 0x38);

    // bits in compressed type * qty
    local WORD qty_bytes = (19+addr_sh)*( ReadUShort(ptr_block_begin+0x0a) +1)/8;
    if(g_akk_shift) qty_bytes++;
    byte TYPES_COMPR[ qty_bytes ] <bgcolor=cBlue, fgcolor=cLtRed>; 

    // ret offset to end of compressed
    //  return ((19+addr_sh)*(ReadUShort(ptr_block_begin+0x0a))/8);
}


//---------------------------------------
DWORD decode_type(unsigned WORD addr_sh){
    // extern global QUAD buffer
    local unsigned DWORD tmp<format=hex>, val<format=hex> =0;
    // type
//Print_buf(buff);
    tmp = get_bits(7,0);    //
//Printf( "\ntype: %02X", tmp);
//Print_buf(buff);
    val = tmp << 24;
    // is_line
    tmp = get_bits(1,0);
    val |= tmp<<16;
    //addr 
/*
0 >>1, r12<<1
1 r12 <<1
2 r12 <<2
*/
    tmp = get_bits(11+addr_sh, 0);
    if(!addr_sh) tmp <<=1;  // bl 0x053d7e, no shift
//Printf(" tmp==%04X ", tmp);
    if(addr_sh) tmp <<= addr_sh-1;
//Printf(" tmp==%04X ", tmp);
    val |= tmp;
//Printf(" val = %08X\n\n", val);
    return val;
}

//-----------------------------------------
// global LIFO buffer - getting bits from head
unsigned DWORD get_bits(WORD bits_from_head_buff, WORD shift_result_after){
    local unsigned DWORD val;
    // use global QUAD buff
    val = buff >> (64 - (bits_from_head_buff ) );
    // Printf (" gb val = %X", val); 
    buff <<= bits_from_head_buff;
    fill_end_buff(bits_from_head_buff);
    val <<= shift_result_after;
    return val;
}

//-----------------------------------
// load more NEXT BITS in the buffer
void fill_end_buff(WORD bits_qty ){
    // use global QUAD  buff, DWORD ptr, WORD akk_shift
    local unsigned QUAD  buf_t<format=hex>;     // temp buff
    local unsigned byte sss;                    // rshifting buf_t
    // bits_qty MUST be less 64
    if(bits_qty > 64){
        break; //err!!!
    }
    // calculate pointer for buf_t
    g_ptr +=  bits_qty>>3;        // qty bytes in bits
    g_akk_shift += (bits_qty % 8);    // 
    if(g_akk_shift >= 8){
        g_akk_shift -=8;
        g_ptr++;
    } 
//     Printf("\n s:%i f:ptr=%08X akk=%i tmp_b:", (bits_qty % 8), ptr+1, akk_shift);
    buf_t = ReadUQuad(g_ptr+1);     // Print_buf(buf_t);
    buf_t >>= 8 - g_akk_shift ;     // Printf("shifted:"); Print_buf(buf_t); Printf(":\n");
    buff |= buf_t; 
return;
}



