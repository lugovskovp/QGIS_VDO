void test_another(DWORD bl_addr, WORD off_start, WORD off_end){
    local DWORD bl_offset = (bl_addr >>8) * 0x800;
    local DWORD ptr = bl_offset + off_start;

    for(ptr; ptr< (bl_offset + off_end); ptr += 4){
        Printf("ptr=%08X x: %04X-%04X = %04X |%04X| ", 
            ptr, ReadUShort(ptr), ReadUShort(ptr+4), ReadUShort(ptr+4) - ReadUShort(ptr),
            ((ReadUShort(ptr+4) - ReadUShort(ptr)) < 0xF000) ?  (ReadUShort(ptr+4) - ReadUShort(ptr)) : (ReadUShort(ptr) - ReadUShort(ptr+4))
            );
        ptr+=2;
        Printf(" y: %04X-%04X = %04X |%04X| \n", 
            ReadUShort(ptr), ReadUShort(ptr+4), ReadUShort(ptr+4) - ReadUShort(ptr),
            ((ReadUShort(ptr+4) - ReadUShort(ptr)) < 0xF000) ?  (ReadUShort(ptr+4) - ReadUShort(ptr)) : (ReadUShort(ptr) - ReadUShort(ptr+4))
            );
    }

}

