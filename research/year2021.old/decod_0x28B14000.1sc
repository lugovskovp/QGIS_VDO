string get_type_addr_1(DWORD buf){
    Printf(" :[%06X] ", buf );
    // ### 1 type
    local WORD val = (buf >> 13) <<7; 
    val = (val & 0xff00) | (val & 0x00FF)>>7;
    Printf(" :%04X", val );
    // ### 2 addr
    val = (buf &0x00000FFF) <<1;
    //val <<=1;
    Printf(" %04X", val );
    if(val == 0) Printf("<---");

    return "$";
}

string get_type_addr(DWORD buf){
    Printf(" [%05X] ", buf );
    // ### 1 type
    local WORD val = (buf >> 12) <<7; 
    val = (val & 0xff00) | (val & 0x00FF)>>7;
    Printf(" :%04X", val );
    // ### 2 addr
    val = (buf &0x00000FFF) <<1;
    //val <<=1;
    Printf(" %04X", val );
    if(val == 0) Printf("<---");

    return "/";
}



void Print_buf(QUAD b){
    Printf("%08X %08X ", b >>32, b & 0xffffffff);
}