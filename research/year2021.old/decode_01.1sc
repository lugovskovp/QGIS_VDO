/*
05000800 0200F000 14236C00 -> 01 00 00 3C  00 00 00 A0  ... 
05160900 0A00F000 C822E400 -> 0x 00 00 3C  00 00 06 40  ... // x != 1, x?=5 
05000900 0200F000 25A01000 -> 01 00 00 3C  00 00 01 2C  ... 
05000800 0200F000 1BA11400 -> 01 00 00 3C  00 00 00 DC  ... 
05000800 0200F000 19230400 -> 01 00 00 3C  00 00 00 C8  ... 
05000900 0200F000 3C20A800 -> 01 00 00 3C  00 00 01 E0  ... 
*/

local DWORD val = 0x0200F000;
local DWORD val_a = 0x25A01000;
//val = 0x0A00F000;

local byte b_tmp, b_out;
Printf("\n\nin: 0x%08X\n", val);

val <<=3;  //first value
Printf(" 0x%08X\n", val);

de(val, val_a);
Printf(" 0x%08X\n", val);

val>>=1; Printf("0x%08X\n", val);
de(val, val_a);

de(val, val_a);
Printf("\n\n -0x%08X\n", val);



return;


// 
void de(DWORD &v, DWORD &a){
        local byte r;
    r = v>>28;

    switch(r){
        case 0:
            pb(0); pb(0); v=v<<8; /*v = v || ( a>>24 ); a<<=8;*/ break;
        case 1:
            pb(1);v=v<<4; break;
        default:
            r=v>>24; pb(r); v=v<<8;  //v = v || ( a>>24 ); a<<=8;
    }

}

    val = val>>1;
Printf("\n\n 0x%08X\n", val);
    b_tmp = val>>24;// 01
    //b_out = get_b_nibble(b_tmp);
    b_out = b_tmp;
    pb(b_out);

    b_tmp = ( val>>20 ) & 0x0f; //00
    b_out = get_b_nibble(b_tmp);b_out = b_tmp;
    pb(b_out);


val = val>>1;
Printf("\n\n 0x%08X\n", val);

    b_tmp = ( val>>16 ); // 00
    b_out = get_b_nibble(b_tmp);
    pb(b_out);


    b_tmp = ( val>>12 ); //3c
    b_out = get_b_nibble(b_tmp);
    pb(b_out);

    b_tmp = ( val>>8 );   p(b_tmp);
    b_out = get_b_nibble(b_tmp);
    pb(b_out);

val = val>>1;
    b_tmp = ( val>>4 );
    b_out = get_b_nibble(b_tmp);
    pb(b_out);

    b_tmp = ( val );
    b_out = get_b_nibble(b_tmp);
    pb(b_out);

return;

byte get_b_nibble(byte a){
    local byte r;
    a = 0x0f & a;
    switch(a){
        case 0:
            r = 0; break;
        case 1:
            r = 1; break;
        default:
            r = 0xFF;
    }
    r = a;
    return r;
}

//--------------------------
void pb(byte a){

   Printf("%02X\n", a); 
}

void p(byte a){

   Printf("->%02X\n", a); 
}
