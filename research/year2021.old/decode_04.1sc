// 
void de(DWORD &v){
        local byte r;
    r = v>>24;

    switch(r){
        case 0:
            pb(0); pb(0); v=v<<8; /*v = v || ( a>>24 ); a<<=8;*/ break;
        case 1:
            pb(1);v=v<<8; break;
        default:
            r=v>>24; pb(r); v=v<<8;  //v = v || ( a>>24 ); a<<=8;
    }

}

    val = val>>1;
Printf("\n\n 0x%08X\n", val);
    b_tmp = val>>24;// 01
    //b_out = get_b_nibble(b_tmp);
    b_out = b_tmp;
    pb(b_out);

    b_tmp = ( val>>20 ) & 0x0f; //00
    b_out = get_b_nibble(b_tmp);b_out = b_tmp;
    pb(b_out);


val = val>>1;
Printf("\n\n 0x%08X\n", val);

    b_tmp = ( val>>16 ); // 00
    b_out = get_b_nibble(b_tmp);
    pb(b_out);


    b_tmp = ( val>>12 ); //3c
    b_out = get_b_nibble(b_tmp);
    pb(b_out);

    b_tmp = ( val>>8 );   p(b_tmp);
    b_out = get_b_nibble(b_tmp);
    pb(b_out);

val = val>>1;
    b_tmp = ( val>>4 );
    b_out = get_b_nibble(b_tmp);
    pb(b_out);

    b_tmp = ( val );
    b_out = get_b_nibble(b_tmp);
    pb(b_out);

return;

byte get_b_nibble(byte a){
    local byte r;
    a = 0x0f & a;
    switch(a){
        case 0:
            r = 0; break;
        case 1:
            r = 1; break;
        default:
            r = 0xFF;
    }
    r = a;
    return r;
}

//--------------------------
void pb(byte a){

   Printf("%02X\n", a); 
}

void p(byte a){

   Printf("->%02X\n", a); 
}
