// 00001010<<8
//0A0106A9                            0C0008D0                        E5C00008



val=( wc>>1 ) & 0xff;
if(val == 0 ){
    p(val); p(val); wc<<=9;
    Printf("02.1: %04X \n", wc );   // 02.1: 0200
    next = ReadByte(ptr++);
    wc |= next;
    Printf("02.2: %04X \n", wc );   // 02.2: 0206 
}else{
