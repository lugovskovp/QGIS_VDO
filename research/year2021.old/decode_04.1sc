if(val == 0 ){
    p(val); p(val); wc<<=3; //4-1
    Printf("--02.1: %04X \n", wc );   // 02.1: 0200
    next = ReadByte(ptr++);
    wc |= next;
    Printf("--02.2: %04X \n", wc );   // 02.2: 0406
}else{
    p(val);
     wc<<=4; 
    next = ReadByte(ptr++);
    wc |= next>>1;
  wc<<=4; 
Printf("3.1: %04X \n", wc );   // 02.1: 0200
}


//05000040 -                               6?010860                        000008D0
