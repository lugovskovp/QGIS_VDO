Printf("%04X \n", wc );

next = ReadByte(ptr++);
wc<<=7;
wc |= next;
Printf("%04X \n", wc );

Printf("%04X- \n", wc );
val = wc>>8;
p(val);

wc<<=8;
next = ReadByte(ptr++);
