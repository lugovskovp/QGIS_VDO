    p(val); wc<<=7; 
    wc<<=4; 
    next = ReadByte(ptr++);
    wc |= next>>4;
    Printf("03.1: %04X \n", wc );   //02.1: 0800 
    val=wc>>9; p(val);
}else{
    p(val);
}
//05000040 -                               6?010860                        000008D0
//00000101+00000000+00000000+01000000++01101001000000010000100001100000+00000000000000000000100011010000

// 0000101+0000    +0000    + 100000 ++ 1101010100         1/00001100000000000000100011010000/
