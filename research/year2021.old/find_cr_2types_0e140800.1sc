string get_type_addr(DWORD buf){
    // ### 1 type
    local WORD val = (buf >> 12) <<7; 
    val = (val & 0xff00) | (val & 0x00FF)>>7;
    Printf(" :%04X", val );
    // ### 2 addr
    val = (buf &0x00000FFF) <<1;
    //val <<=1;
    Printf(" %04X", val );
    if(val == 0) Printf("<---");

return "/";
}