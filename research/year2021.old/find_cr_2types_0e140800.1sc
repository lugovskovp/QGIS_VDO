//Printf("bl_addr :cnt_types poliline_offs :  DW_1 DW_2\n"); 
for(ptr=ptrStart; ptr<ptrEnd; ptr+=constBlSize){
    if(FSeek(ptr) != 0){    // EOF -> exit
        Printf("0x%08X EOF!\n", ptr); return;}

    val = ReadUInt(ptr);
    // is this block start?
    if( ((val>>8)*constBlSize) == ptr){
        // check block type\
        blockType = ReadByte(ptr+0x05);
        //Printf("%01X    \n", blockType);
        if( !( (blockType == 0x16 ) || (blockType == 0x15 ) || (blockType == 0x1c )
            || (blockType == 0x14 ) || (blockType == 0x1d ) || (blockType == 0x1e ) ) )
