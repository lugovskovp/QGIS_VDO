            continue;
        }
*/

        // read key dword , 0e 14 08 00
// 0E140800 === cb<<7=6580=6501;1dc<<1  = 03b8
        if(ReadUInt(ptr+0x34) != 0x0e140800){
            continue;
        }

//only 3 times
if(k++ > 2) return;

        FlagCompressed = ReadByte(ptr+0x06);
        if(FlagCompressed == 1){
            // 2- smallest

            if(ReadUInt(ptr+0x34) == 0x0e140800){   // 0E 14 08 00 === cb<<7=6580=6501;1dc<<1  = 03b8
                Printf("\n\n bl_offset( 0x%08X ); // 0x0e140800 [t:%04X]\n", ptr, ReadUShort(ptr+0ah) );
                //
                buffer = ReadUInt(ptr+0x38);
                off = ptr+0x38+4; //next byte
                
                flag_read_half = 0;
                add_shift = 0;

                
Printf("\n%08X ", buffer);
if (){
    Printf(" :%s ", get_type_addr(buffer >>12) );
    add_shift=1;
}

if(add_shift){

}else{
    Printf(" :%s ", get_type_addr(buffer >>12) );
}
//#load next
buffer <<=20;
if(flag_read_half == 1){
    buffer |= ReadUInt(off)>>8;
    off+=3;
    flag_read_half = 0;
}else{
    buffer |= ReadUInt(off)>>12;
    off+=2;
    flag_read_half = 1;
}

                for(i=0; i<4; i++){

Printf("\n%08X ", buffer);
Printf(" :%s ", get_type_addr(buffer >>12) );

//#load next
buffer <<=20;
if(flag_read_half == 1){
    buffer |= ReadUInt(off)>>8;
