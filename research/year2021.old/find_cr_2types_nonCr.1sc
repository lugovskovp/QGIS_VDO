//------------------------------------------------
//--- 010 Editor v11.0.1 Script File
//
//      File:  Find block by type and length
/*
Find only non-copressed block with size > 3
*/
BigEndian(); 
Printf("\n\nfile name: %s\n\n", FileNameGetBase( GetFileName() ));

// ee_map.txt
// - 2B6D2800: 056DA501 :  			1c_MAP_POLI_9_k100 --- 0262
//   2B873000: 0570E601 :  	08_SCALE_ALMANAC --- 0001
//      local DWORD ptr, ptrStart = 0x2B6D2800, ptrEnd = 0x2B873000, constBlSize=0x800;
local DWORD ptr, ptrStart, ptrEnd, constBlSize=0x800;
local DWORD val;
local byte blockType, FlagCompressed, cnt_types, end_offs;
local WORD inner_offset <format=hex>;
local DWORD ch_sea1 , ch_sea2;
local WORD eof_poli;

local unsigned WORD i,j,k=0, tmp_w;
local unsigned DWORD tmp_a, add_shift=0;

// ee 28AD2000: 0515A401 :  			16_MAP_POLI_7_k40 --- 4806
ptrStart = 0x28AD2000; ptrEnd = 0x2B947000;//ee
// bnl 0B6BE000: 016D7C01 :  			16_MAP_POLI_7_k40 cnt- 0838
//ptrStart = 0x0B6BE000; ptrEnd=0x0C05F000;//bnl

Printf("bl_addr :cnt_types poliline_offs :  DW_1 DW_2\n"); 
for(ptr=ptrStart; ptr<ptrEnd; ptr+=constBlSize){
    if(FSeek(ptr) != 0){    // EOF -> exit
        Printf("0x%08X EOF!\n", ptr); return;}

    val = ReadUInt(ptr);
    // is this block start?
    if( ((val>>8)*constBlSize) == ptr){
        // check block type\
        blockType = ReadByte(ptr+0x05);
        //Printf("%01X    \n", blockType);
        if( !( (blockType == 0x16 ) || (blockType == 0x15 ) || (blockType == 0x1c )
            || (blockType == 0x14 ) || (blockType == 0x1d ) || (blockType == 0x1e ) ) )
            continue;

        // is this block compressed?
        if(ReadByte(ptr+0x06) == 1){
            // continue;
        }else{  //block not compressed
            continue;
        }

 /*       // cnt types 0bh
        if(ReadByte(ptr+0x0b) != 3) {
            continue;
        }
*/

        // read key dword , 0e 14 08 00
// 0E140800 === cb<<7=6580=6501;1dc<<1  = 03b8
        if(ReadUInt(ptr+0x34) != 0x0e140800){
            continue;
        }

if(k++ > 3) return;

        FlagCompressed = ReadByte(ptr+0x06);
        if(FlagCompressed == 1){
            // 2- smallest
            
            if(ReadUInt(ptr+0x34) == 0x0e140800){// 0E 14 08 00 === cb<<7=6580=6501;1dc<<1  = 03b8
                Printf("\n bl_offset( 0x%08X ); // 0x0e140800 [%04X]\n", ptr, ReadUShort(ptr+0ah) );
add_shift = 0;
                for(i=0; i<20; i+=5){
                    //tmp_a = ReadUInt(ptr+0x38+i)<< add_shift;
if(add_shift) add_shift++;
tmp_a = ReadUInt(ptr+0x38+i)<<add_shift;
tmp_a>>=12;
Printf(" %05X - ", ReadUInt(ptr+0x38+i)>>12 );
                    Printf("/%i/ %05X -> ", add_shift, tmp_a);
                    tmp_w = (tmp_a)>>5;// see 6580->6501
                    tmp_w = (tmp_w & 0xff00) | (tmp_w & 0x00FF)>>7; // >>(0xe ????
                    Printf(" %04X ", tmp_w); 
                    tmp_a = (tmp_a & 0x0FFF );
if(tmp_a < 0x20) add_shift = 1; // ??? ++
                    Printf("%04X  ",tmp_a<<(1+add_shift));
                    // 
                   //tmp_a = ReadUInt(ptr+0x38+i+2)<<(4+add_shift);
//tmp_a = ReadUInt(ptr+0x38+i+2)<<(4+add_shift);
tmp_a = ReadUInt(ptr+0x38+i+2)<<add_shift;
tmp_a>>=8;
tmp_a &= 0x0fffff;

tmp_a = ReadUInt(ptr+0x38+i+2)<<add_shift;;
tmp_a>>=8;
tmp_a &= 0x0fffff;
                    Printf("../%i/ %05X -> ", add_shift, tmp_a);
                    tmp_w = (tmp_a)>>5;// see 6580->6501
                    tmp_w = (tmp_w & 0xff00) | (tmp_w & 0x00FF)>>7; // >>(0xe ????
                    Printf(" %04X ", tmp_w); 
                    tmp_a = (tmp_a & 0x0FFF );
                    Printf("%04X  ",tmp_a<<(1+add_shift));
/* 

                    tmp_a = (tmp_a & 0x00FFFFF0 )>>12;
                   // if(tmp_a < 0x20) tmp_a<<=1;
                    Printf("%04X  ",tmp_a<<1);
*/
                    Printf("\n");

                }
                continue;
            }

                inner_offset = ReadUShort(ptr + 8);
            cnt_types = ReadByte(ptr + 0xb);
            end_offs = ReadByte(ptr + 0xd);
            ch_sea1 = ReadUInt( ptr + inner_offset);
            ch_sea2 = ReadUInt( ptr + inner_offset + 4);
            Printf("bl_offset( 0x%08X ); // :%02X\t%i-%i: \t%08X %08X %08X %08X ->", ptr, 
                cnt_types, ReadUShort( ptr+0xe), ReadUShort( ptr+0x12),
                ch_sea1, ch_sea2,
                 ReadUInt( ptr + inner_offset + 8) ,
                ReadUInt( ptr + inner_offset + 12)
                ); 
             // should be
            // 0x28B55000 :01 3C :  05000800 0200F000 -> 01 00 00 3C 00 00 00 DC
            //  end of poligons ptr 
            eof_poli = ( ReadUShort(ptr+0x0e) * 0x14 ) + ReadUShort(ptr+0x0c);
eof_poli = ReadUShort(ptr+0x14) - 0x10;
            Printf(" %02X%02X%02X%02X  %02X%02X%02X%02X %02X%02X%02X%02X  ... \n", 
                ReadByte(ptr + 0x38)>>1, 0, // type, 0-poligon
                ReadUShort(ptr+0x0c)>>8 , ReadUShort(ptr+0x0c) & 0xff , // poligon ptr
                65h, 1, // poli start !!!!!65 - read as 6x, 1 - poliline
                (ReadUShort(ptr+0x10))>>8 , (ReadUShort(ptr+0x10)) & 0xff,

                0,0,// last type =0, ptr2:pstr-10h
                (ReadUShort(ptr+0x14)-10h)>>8 , (ReadUShort(ptr+0x14)-10h) & 0xff
                );  
            //break;
        }else{
            Printf("bl_offset( 0x%08X ); \n", ptr);
        }
    }
}
//


return;

