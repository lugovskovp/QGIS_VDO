/*
https://habr.com/ru/post/102521/

//code_counts - массив количеств кодов из 16 элементов.
code = 0
for(i in 0..16)
{
  for(j in 0..code_counts[i])
  {
    codes[(i + 1,  code)] = read_next_value(); //i + 1 — битовая длина кода, в младших битах (i + 1) code сам код
