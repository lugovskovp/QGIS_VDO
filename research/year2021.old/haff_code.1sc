res=1;
// 0a0006015050
for(j=1; j<10; j++){
    in = in | r_uncomp[j];
//in<<=1;
    Printf("%04X j:%i r:%08X\n", in, j, res);
    for(i=0; i< 9; i+=2){
        Printf("%04X %01X i:%i\n", (in<<i), ((in<<i) >> 14), i);
        switch(in >> 14){
            case 0x0:
                res = res<<1 | eq_00;
                bit_out_cnt ++;
                break;
            case 0x1:
                res = (res<<3) | eq_01;
                bit_out_cnt += 3;
                break;
            case 0x2:
                res = (res<<3) | eq_10;
                bit_out_cnt += 3;
                break;
            case 0x3:
                res = (res<<3) | eq_11;
                bit_out_cnt += 3;
                break;
            default:
                break;
        }
        in = in<<2;
        //Printf("\nr0: 0x%08X %i\n", res, bit_out_cnt);
    }// i

}// j

Printf("\n%i\n",bit_out_cnt);
