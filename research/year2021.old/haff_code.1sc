local uchar _uncomp[15] <format=hex> = {1, 2, 3, 4, 5, 6, 7, 8, 9, 0xa, 0xb, 0xc, 0xd, 0xe, 0xf};

// 0x0100004c
// 0000 0001 0000 0000 0000 0000 0100 1100 

//bl0570d006 -0108 from54, 7obj
local uchar r_uncomp[24] <format=hex> = {1,0,0,0x54,0,5,0,1,0};
// wait: 0c 1c 0a 00 06 01 50 50 a8 03 05 cc
