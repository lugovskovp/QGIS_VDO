BigEndian(); 

string bit_rep( byte ch)
{
    local string s="", res="";
    local byte i;
    for(i=3; i>=0; i--){
    
        switch( ( ch>>(i*2) ) & 0x3){
        case 0:
            s="00";
            break;
        case 1:
            s="01";
            break;  
        case 2:
            s="10";
            break;  
        case 3:
            s="11";
            break;   
        }
        SPrintf(res, "%s%s", res, s);
    }
    //Printf("\nres: %s\n", res);
    return res;
}

