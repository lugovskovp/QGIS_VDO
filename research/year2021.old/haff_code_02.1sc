local DWORD bl_addr, ptr_start, ptr, i, j;
bl_addr = 0x05723A03 ;

ptr_start = addr2ptr(bl_addr);
local en_BL_DATA_TYPE type = ReadByte(ptr_start + 5) ;
Printf("\nBlock addr: 0x%08X; ObjTypes: %i; 0x%02X%s; ", 
        bl_addr, ReadByte(ptr_start + 0xb),
        type, EnumToString(type) );
Printf("Riga @56.9845008,24.1897154\n");



/// compressed bytes
local uchar cr_size = 0x20;
local uchar crypted[cr_size] <format=hex>;
    //read
ptr = ptr_start + ReadByte(ptr_start + 9);
//ptr += 4;
    for(i=0; i<cr_size; i++){
        crypted[i] = ReadByte(ptr++);
    }
    //print
//Printf("\n");

// print 4 firs bytes crypted
    for (i=0; i<4; i++){
        //Printf("   %02X    ", crypted[j*8 + i] );
        Printf(" %02X (%i) ", crypted[i], crypted[i] );
    }
    Printf("\n");
    for (i=0; i<4; i++){
        Printf("%s ", bit_rep(crypted[i]) );
    }
    Printf("\n");

ptr=4; // as cntr

for(j=0; j<2; j++){
    for (i=0; i<8; i++){
        //Printf("   %02X    ", crypted[j*8 + i] );
        Printf("   %02X    ", crypted[ptr++] );
    }
    ptr -= 8;
    Printf("\n");
    for (i=0; i<8; i++){
        Printf("%s ", bit_rep(crypted[ptr++]) );
    }
    Printf("\n");
}

// waited bytes
local uchar ch_wait[8] = {1, 0, 0, 0x54, 5, 0, 1};
ch_wait[2] = ReadByte(ptr_start+0xc);
ch_wait[3] = ReadByte(ptr_start+0xd);

for (i=0; i<8; i++){
    Printf("   %02X    ", ch_wait[i] );
}
Printf("\n|");
for (i=0; i<8; i++){
    Printf("%s|", bit_rep(ch_wait[i]) );
}
//Printf("\n");


//---------------------------------
DWORD addr2ptr(DWORD addr){
    return (addr>>8)*0x800;
}

string bit_rep( byte ch)
{
    local string s="", res="";
    local byte i;
    for(i=3; i>=0; i--){
        switch( ( ch>>(i*2) ) & 0x3){
        case 0:
            s="00";
            break;
        case 1:
            s="01";
            break;  
        case 2:
            s="10";
            break;  
        case 3:
            s="11";
            break;   
        }
        SPrintf(res, "%s%s", res, s);
    }
    return res;
}