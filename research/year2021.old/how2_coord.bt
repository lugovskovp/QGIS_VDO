//zayachi ostrov  @59.9677172,30.2939939
lat = 59.9677172;
lon = 30.2939939;

// @28.2685357,-16.3828795 - tenerife
lat = 28.2685357;
lon = -16.3828795;

// @38.7116171,-9.1356795 - lisboa - lissabon
lat = 38.7116171;
lon = -9.1356795;

// point above tenerife
lat =  32.870774;
lon = -14.936804;

*/

DWORD get_map_poligons_bl_addr(uchar scale, double lat, double lon){
    local DWORD res_bl_map=0;
// 10 - 1d (1 - 00 0a)
// 9  - 1c  1 - 00 08
// 7  - 16  1 - 00 06
// 6  - 15  1 - 00 07 
    if ((scale >10) || (scale < 6) || (scale == 8)) return 1;

// 0x07 07_LIST_GEO_MAPS    // 00 00 02:01  - 
    bl_addr(0x00000201); 
    local DWORD world_bl_hlon <format=hex> = __bl_0x07.__scales.scale[scale].world_bot_left.hlon;
    local DWORD world_bl_hlat <format=hex> = __bl_0x07.__scales.scale[scale].world_bot_left.hlat;
    local DWORD qty_in_side_almanac <format=hex> = __bl_0x07.__scales.scale[scale].qty_in_side_almanac;

//0x08 almanac of folders of maps
    bl_addr(__bl_0x07.__scales.scale[scale].bl_almanac.hex); 

    local DWORD hla_goal <format=hex> = doubleLat2hlat(lat);
    local DWORD hlo_goal <format=hex> = doubleLon2hlon(lon);
    
 // calc folder_map index
    local int fold_x = (hlo_goal - world_bl_hlon) /  __bl_0x08.folder_side_size;
    local int fold_y = (hla_goal - world_bl_hlat) /  __bl_0x08.folder_side_size;
    local int fold_ind = fold_x * qty_in_side_almanac + fold_y;
// bl 0x09
    bl_offset(__bl_0x08.folder[ fold_ind ].offset);  

// calc map index in folder
    local DWORD folder_bl_hlat <format=hex> = world_bl_hlat + fold_y * __bl_0x08.folder_side_size ;
    local DWORD folder_bl_hlon <format=hex> = world_bl_hlon + fold_x * __bl_0x08.folder_side_size;
    //local double folder_bl_lat = hlat2double(folder_bl_hlat);
    //local double folder_bl_lon = hlon2double(folder_bl_hlon);

    local DWORD folder_bl_hlat_delta <format=hex> = fold_y * __bl_0x08.folder_side_size;
    local DWORD folder_bl_hlon_delta <format=hex> = fold_x * __bl_0x08.folder_side_size;
    local int map_y = (hla_goal  - folder_bl_hlat_delta - world_bl_hlat) / __bl_0x09.map_side_size;
    local int map_x = (hlo_goal  - folder_bl_hlon_delta - world_bl_hlon) / __bl_0x09.map_side_size;
    local int map_ind = map_x * __bl_0x08.folder[ fold_ind ].qty_maps_folder_side + map_y;

    , = __bl_0x09.maps.map[map_ind].hex;
   
    return res_bl_map;
}


