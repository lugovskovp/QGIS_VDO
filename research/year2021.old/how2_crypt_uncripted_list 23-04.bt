 return;
local int i=0x0515A6;       //0515A6 - first 16 tpe
local int offs;
local int addr, type, usl;
local int iscompr, ptr, aptr;
for (i; i<0x0576f7; i++){ //0x0576f7 - end EE
    
    offs = i*0x800;
    FSeek(offs);
    addr = ReadUInt();
    //ReadUQuad(buff.ptr);
    if ((addr >> 8) == i){
        FSeek(offs+4);
        type = ReadUInt();
        iscompr = (type >> 8) & 0xFF;
        if (!iscompr){
            FSeek(offs+0x34);
            usl = ReadUInt();
            FSeek(offs+0xd);
            ptr = ReadUByte();
            FSeek(offs+0x34+5);
            aptr = ReadUShort();
            FSeek(offs+0x38);
            /*Printf("-- 0x%06X %06X %01i %02X %08X %08X --usls: %08X\n", 
                offs, i, iscompr, (type >> 16) & 0xFF,
                addr, type, ReadUInt());*/
            Printf("%01i\t%02X\t%02X\t%02X\t%08X %08X --usls: \t'%04X\t'%04X\t", 
                iscompr, (type >> 16) & 0xFF, addr &0xFF, type &0xFF,
                addr, type, (usl>>16), (usl&0xFFFF));
            Printf("'%08X\t'%02X\t'%02X\t'%02X\t'%02X\t'%02X\t'%02X\t\n", ReadUInt(), ptr, 
                 aptr, aptr>>1, aptr>>2, aptr>>3, aptr>>4);
        }
    }
}

