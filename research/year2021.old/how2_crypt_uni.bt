void decode_types(DWORD block_offset){
    local DWORD ptr = block_offset + 0x38; // ptr 2 coded Types
    local unsigned QUAD buffer, buf_t;
    local unsigned WORD d_len = 20, tmp_w;
    local unsigned DWORD res;
    
    //
    buffer = ReadUQuad(ptr); // 8 first coded Types
    ptr += 8; //next packet of bytes
                
    //  Print_buf( buffer );

    // #1 add_shift - qty bits for addr in type
    tmp_w = buffer>> (64-20) & 0xff;    // first 5 nibbles - type and inner offset
    //  Printf("\n addr first  %04X\n",( tmp_w ));
   // if( tmp_w<<0 == ReadUShort(block_offset +0x0c) ) d_len = 19;
    if( tmp_w<<1 == ReadUShort(block_offset +0x0c) ) d_len = 20;
    if( tmp_w<<2 == ReadUShort(block_offset +0x0c) ) d_len = 21;
   // if( tmp_w<<3 == ReadUShort(block_offset +0x0c) ) d_len = 22;
    //  Printf(" data bits   %i\n",( d_len ));
    Printf("\n\n bl_offset( 0x%08X ); // 0x%08X [%i types] %i\n", block_offset, ReadUInt(block_offset+0x34), 
            ReadUShort(block_offset+0ah), d_len );

    
    //1,2
    res = calc_type_addr(buffer >>(64-d_len), d_len);
    buffer <<= d_len;
    Printf (" %08X ", res);
    res = calc_type_addr(buffer >>(64-d_len), d_len);
    buffer <<= d_len;
    Printf (" %08X ", res);
        tmp_w = res>>28;
    buf_t = ReadUQuad(ptr)>>(64 - d_len*2);
    buffer |= buf_t;
    //Print_buf( buf_t );
    ptr+=5;
    Printf("\n");
    
    
    //3,4
    res = calc_type_addr(buffer >>(64-d_len), d_len);
    buffer <<= d_len;
    Printf (" %08X ", res);
    res = calc_type_addr(buffer >>(64-d_len), d_len);
    buffer <<= d_len;
    Printf (" %08X ", res);
    //  bl_offset( 0x28D0C800 ); // 0x0E140800 [6 types] 20
    if ( tmp_w > 0) {
        buf_t = ReadUQuad(ptr)>>(64 - d_len*2);
    }else{
        buf_t = ReadUQuad(ptr) >>20;
    }
    //
    buffer |= buf_t;
    ptr+=5;
    Printf("\n");
    
    //5,6
    res = calc_type_addr(buffer >>(64-d_len), d_len);
    buffer <<= d_len;
    Printf (" %08X ", res);
    res = calc_type_addr(buffer >>(64-d_len), d_len);
    buffer <<= d_len;
    Printf (" %08X ", res);
    //buf_t = ReadUQuad(ptr)>>(64 - d_len*2);
    buf_t = ReadUQuad(ptr) >>18;
    buffer |= buf_t;
    ptr+=5;
    Printf("\n");
    
    //7,8
    res = calc_type_addr(buffer >>(64-d_len), d_len);
    buffer <<= d_len;
    Printf (" %08X ", res);
    res = calc_type_addr(buffer >>(64-d_len), d_len);
    buffer <<= d_len;
    Printf (" %08X ", res);
    
    buf_t = ReadUQuad(ptr)>>16;
    buffer |= buf_t;
    ptr+=5;
    Printf("\n");
    
    //9,10
    res = calc_type_addr(buffer >>(64-d_len), d_len);
    buffer <<= d_len;
    Printf (" %08X ", res);
    res = calc_type_addr(buffer >>(64-d_len), d_len);
    buffer <<= d_len;
    Printf (" %08X ", res);
    
    
    buf_t = ReadUQuad(ptr)>>16;
    buffer |= buf_t;
    ptr+=5;
    
    Printf("\n");

    return;
}


//----
DWORD calc_type_addr(DWORD buf, WORD len){
    local unsigned DWORD res;
    // Printf(" :[%05X] \t", buf );
        // ### 1 type
    local WORD type = (buf >> (len-8) ) <<7; 
    type = (type & 0xff00) | (type & 0x00FF)>>7;
//    Printf(" %04X", type );
        // ### 2 addr
    local WORD val = (buf &0x00000FFF) <<1;
    //val <<=1;
//    Printf(" %04X ", val );
//    if(type == 0) Printf("<---\n"); // last, 0000 xxxx <-ptr2str-10h
    res = type;
    res <<= 16;
    res |= val;
//    Printf(" =%08X= ", res );
    return res;
}




void Print_buf(QUAD b){
    Printf(" %08X %08X ", b >>32, b & 0xffffffff);
}

