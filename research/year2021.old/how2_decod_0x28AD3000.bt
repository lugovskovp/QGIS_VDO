local WORD i, tmp_val, max_x=0, max_y=0, qty_delta;
local DWORD tmp_ptr, curr_x, curr_y;

//struct BLOCK_TYPE_0x16 __bl_0x16

pbn(__bl_0x16.buff);

tmp_val = __bl_0x16.head.vrtx_max_x;
do{
    max_x++;
}while(tmp_val >>=1);
tmp_val = __bl_0x16.head.vrtx_max_y;
do{
    max_y++;
}while(tmp_val >>=1);
Printf("max_x=0x%X max_y=0x%X \n", max_x, max_y);

qty_delta = 9;
pull_bits(__bl_0x16.buff, 32);
// 0

//curr_x = pull_bits(__bl_0x16.buff, max_x);
//curr_y = pull_bits(__bl_0x16.buff, max_y);
//Printf("%i  x=0x%04X y=0x%04X ", i, curr_x, curr_y);
i++;
pbn(__bl_0x16.buff);

for(i=0; i < 18; i++){
// 1
    if( show_bits(__bl_0x16.buff, 1) == 0 )
        curr_x = pull_bits(__bl_0x16.buff, max_x);
    else{
        pull_bits(__bl_0x16.buff, 1);
        curr_x += pull_bits(__bl_0x16.buff, qty_delta);
    }
    
    if( show_bits(__bl_0x16.buff, 1) == 0 )
        curr_y = pull_bits(__bl_0x16.buff, max_y);
    else{
        pull_bits(__bl_0x16.buff, 1);
        curr_y += pull_bits(__bl_0x16.buff, qty_delta);
    }
    Printf("%i  x=0x%04X y=0x%04X ", i, curr_x, curr_y);

    pbn(__bl_0x16.buff);
}


