void print_about_coord( double lat, double lon, string rem){
    local uchar i;
    local DWORD  block_a;
    Printf("\n");
    for(i=0; i<=11; i++){
        block_a = get_bl_poli_addr(lat, lon, i);
        //Printf("scale: %i;  poli - 0x%08X\n" , i, block_a );
        Printf("bl_addr(0x%08X);\t// scale %i\n" , block_a, i );
    }
}




// getting bl_addr by coordinates and scale num, or 0 if not exist
DWORD get_bl_poli_addr(double lat, double lon, uchar scale_num){
    local DWORD bl_res;
    // check in values
    local int hlat = double2hlat(lat), hlon=double2hlon(lon);
    // < bl
    if( hlat < __bl_0x07.__scales.scale[0].world_bot_left.hlat)
        return 0;
    if( hlon < __bl_0x07.__scales.scale[0].world_bot_left.hlon)
        return 0;
    // > tr
    if( hlat > __bl_0x07.__scales.scale[0].world_top_right.hlat)
        return 0;
    if( hlon > __bl_0x07.__scales.scale[0].world_top_right.hlon)
        return 0;
    if( (scale_num > 11) || (scale_num == 8) )
        return 0;
//Printf("\n%s: %08X %08X %f, %f\n", rem, hlon, hlat, lat, lon);

    // find folder_num - num in array 0x08 file
    if ( __bl_0x07.__scales.scale[scale_num].bl_almanac.hex == 0)
        return 0;
    local int world_bl_hlat, world_bl_hlon;
world_bl_hlat = __bl_0x07.__scales.scale[scale_num].world_bot_left.hlat;
world_bl_hlon = __bl_0x07.__scales.scale[scale_num].world_bot_left.hlon;

    local int folder_side_size, folder_x, folder_y, folder_num;
    folder_side_size = __bl_0x07.__scales.scale[scale_num].folder_side_size;
//Printf("0x%0X\n",folder_side_size);
    folder_x = (hlat - world_bl_hlat)/folder_side_size;
    folder_y = (hlon - world_bl_hlon)/folder_side_size;
    folder_num = folder_x + (folder_y * __bl_0x07.__scales.scale[scale_num].qty_in_side_almanac);

    local DWORD bl_08_offset = __bl_0x07.__scales.scale[scale_num].bl_almanac.offset;
//Printf("0x08: 0x%08X \n", bl_08_offset);

    local DWORD bl_09_offset = ((ReadUInt(bl_08_offset + 0x10 + 4*folder_num) >>8) * 0x800);
    if( !bl_09_offset )
        return 0;
//Printf("FOL x: %i  y: %i\n  N folder: %i ; bl_09_offset = 0x%08X\n",  folder_x, folder_y, folder_num, bl_09_offset);

    // find map_num - num in array 0x09 file
    local int map_side_size, qty_in_side_folder, map_x, map_y, map_num;
    map_side_size = ReadUInt(bl_09_offset + 0x10);
    qty_in_side_folder = folder_side_size / map_side_size;
//Printf("0x09: 0x%08X \n", bl_09_offset);
//Printf("map side: 0x%0X|%i; qty: 0x%0X|%i \n", map_side_size, map_side_size, qty_in_side_folder, qty_in_side_folder);

    map_x =( hlat - folder_x*folder_side_size - world_bl_hlat) / map_side_size;
    map_y =( hlon - folder_y*folder_side_size - world_bl_hlon) / map_side_size;
    map_num = map_x + map_y * qty_in_side_folder;
//Printf("MAP x: %i  y: %i\n  N map: %i \n", map_x, map_y, map_num);

    // bl_POLI_addr 
    local DWORD  inner_offset_to_poli;
inner_offset_to_poli = ReadUShort(bl_09_offset + 
                            ReadUShort(bl_09_offset + 0x8) + 2*map_num );
// Printf("\ninner_offset_to_poli: 0x%08X \n", inner_offset_to_poli);
    if( !inner_offset_to_poli)
        return 0;
    bl_res = ReadUInt(bl_09_offset + inner_offset_to_poli);

    //bl_res = ReadUInt(inner_offset_to_poli);

// Printf("0xPOLI: 0x%08X \n", bl_res);
    return bl_res;
}

