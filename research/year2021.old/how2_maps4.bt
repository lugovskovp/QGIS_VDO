// =========================================================
void print_about_coord( double lat, double lon, string rem){
    local uchar i;
    local DWORD  block_a;
    Printf("\n// %s\n", rem);
    for(i=0; i<=11; i++){
        block_a = get_bl_poli_addr(lat, lon, i);
        if(!block_a){
            Printf("// no scale %i\n", i);
        }else{
            //Printf("scale: %i;  poli - 0x%08X\n" , i, block_a );
            Printf("bl_addr(0x%08X);\t// scale %i\n" , block_a, i );
        }
    }
}




// return bl_addr by coordinates and scale num, or 0 if not exist
DWORD get_bl_poli_addr(double lat, double lon, uchar scale_num){
    local DWORD bl_res <format=hex>; //  result BL_ADDR
    local DWORD tmp_offset <format=hex>;
    
    // info from 0x07 - world scales
    local DWORD side_world <format=hex>;   // tr-bl

    // info from 0x08 - folders almanac
    local DWORD folder_side_size <format=hex>;   // side size items 0x08 almanac
    local DWORD folders_side_qty; // qty folders in almanac = (side_world / folder_side_size) ** 2
    local int folder_x, folder_y, folder_num;
    
    // info from 0x09 - maps folder
    local DWORD map_side_size <format=hex>;
    local DWORD maps_side_qty;
    local int map_x, map_y, map_num;
    
    // ------------------- double lat lon -> hex
    local int hlat = double2hlat(lat), hlon=double2hlon(lon);

    // ------------------- check input values - are they in carindb world   
    if( (scale_num > 11) || (scale_num == 8) )
        return 0;
    if(  __bl_0x07.__scales.scale[scale_num].bl_almanac.hex == 0)
        return 0;       // There are no 0x08 alanac in scale
    if( (hlat < __bl_0x07.__scales.scale[scale_num].world_bot_left.hlat)  ||
        (hlon < __bl_0x07.__scales.scale[scale_num].world_bot_left.hlon) )
            return 0;       //      < bl
    if( (hlat > __bl_0x07.__scales.scale[scale_num].world_top_right.hlat) ||
        (hlon > __bl_0x07.__scales.scale[scale_num].world_top_right.hlon) )
            return 0;       //      > tr

    // ------------------- 
    side_world = __bl_0x07.__scales.scale[scale_num].world_top_right.hlon - 
        __bl_0x07.__scales.scale[scale_num].world_bot_left.hlon; 
    
    // Offset to DWORD 0x08.folder_side_size , bl_08_offset
    tmp_offset = __bl_0x07.__scales.scale[scale_num].bl_almanac.offset + 0x0c;
    folder_side_size = ReadUInt(tmp_offset);
    folders_side_qty = side_world / folder_side_size;
    folder_x = (hlat - __bl_0x07.__scales.scale[scale_num].world_bot_left.hlat)/folder_side_size;
    folder_y = (hlon - __bl_0x07.__scales.scale[scale_num].world_bot_left.hlon)/folder_side_size;
    folder_num = folder_x + (folder_y * folders_side_qty);
    

    // bl_09_offset 
    tmp_offset = ((ReadUInt(__bl_0x07.__scales.scale[scale_num].bl_almanac.offset 
        + 0x10 + 4*folder_num) >>8) * 0x800);
    if( !tmp_offset )
        return 0; // trere are no folder block for this coordinates

    // find map_num - num in array 0x09 file
    map_side_size = ReadUInt(tmp_offset + 0x10);
    maps_side_qty = folder_side_size / map_side_size;
    map_x =( hlat - __bl_0x07.__scales.scale[scale_num].world_bot_left.hlat
            - folder_x*folder_side_size) / map_side_size;
    map_y =( hlon - __bl_0x07.__scales.scale[scale_num].world_bot_left.hlon
            - folder_y*folder_side_size) / map_side_size;
    map_num = map_x + map_y * maps_side_qty;

    // bl_POLI_addr 
    local DWORD  inner_offset_to_poli = ReadUShort(tmp_offset + 
                            ReadUShort(tmp_offset + 0x8) + 2*map_num );
    if( !inner_offset_to_poli)
        return 0;
    bl_res = ReadUInt(tmp_offset + inner_offset_to_poli);

    return bl_res;
}