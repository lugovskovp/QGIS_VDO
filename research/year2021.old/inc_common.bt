    CH_country  = 0Bh,  //fully parsed chars idxs
    COUNTRY     = 0Ah,  //fully parsed COUNTRY INFO
    CH_idx_d    = 0Dh,  //fully parsed chars idxs
    CITY        = 0ch,  //fully parsed CITY INFO
    CH_idx_f    = 0Fh,  //fully parsed chars idxs
    ROAD        = 0Eh,  //
    CH_idx_11   = 11h,  //fully parsed chars idxs
    POI        = 10h,  // fully parsed, POI
    
    Invalid  = 0xFF
}en_BL_TYPE <format=hex>;

