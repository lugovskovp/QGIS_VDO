// --- Data structs and functions -----------------------------
// }BL_ADDR Структура адреса блока
typedef struct{
    // 
    BitfieldDisablePadding();  //биты - как сплошная последовательность 
    local uchar  is_valid <hidden=true>; // Признак валидности структуры, default-0 
    local uint   raw <hidden=true> = ReadUInt(FTell()); // read onplace var value
    local uint   offset <hidden=true> = ((raw & 0xffffff00)<<3); // calc offset
    local en_BL_TYPE type=0xFF;       // Тип блока который начинается по этому адресу
    local ushort r_size=0;   // real uncompressed size, if 0 - block uncompressed
    if( !raw ){     // raw=0 -> empty BL_ADDR, 00 00 00 00
        unsigned int    addr : 24 <bgcolor=0x00a0f0, fgcolor=cYellow>; //первые 3 байта - адрес, offset/0x800
        unsigned short  size : 8 <bgcolor=0x00a0f0, fgcolor=cDkAqua>;  //последний байт - размер
        is_valid = 1;// 00 00 00 00 - too valid
    }else{ // raw > 0, have data
        if ( offset < FileSize() )   // Если offset внутри file
            is_valid = ( ReadUInt(offset) == raw );   // Прочитать реальное значение по offset адресу
        if(!is_valid){  // data on addr != addr
            DWORD non_valid_bl_addr<bgcolor=cRed, fgcolor=cSilver>; // paint it in red
        }else{ // data on addr == addr, All Clear!
            // получить тип блока       
            type = ReadUByte(offset+5); // Через байта после BL_ADDR - type
            // get value compressed size
            r_size = ReadUByte(offset+7) * 0x800; // if non compressed = 0
            unsigned int    addr : 24 <bgcolor=0x00a0f0, fgcolor=cYellow>; //первые 3 байта - адрес, offset/0x800
            if(!r_size){  // non - compressed
                unsigned short  size : 8 <bgcolor=0x00a0f0, fgcolor=cDkAqua>;  //последний байт - размер
                r_size = size * 0x800;
            }else{  // 
                unsigned short  size : 8 <bgcolor=cRed, fgcolor=cSilver>;  //последний байт - размер 
            }
        }
    }  
}BL_ADDR <read = Read_BL_ADDR>;

// Во вкладке Variables в колонку Value вывести строковое значение
string Read_BL_ADDR(BL_ADDR &a){
    local string s;
    if( a.is_valid){
            SPrintf(s, "block(0x%08X); //:%02Xh(%s) sz=%i of:0x%08X", 
        a.raw, a.type, EnumToString(a.type), a.size, a.offset);
    }else{
        // Если по рассчитанному смещению лежит иное значение, 
        SPrintf(s, "%s =0x%08X", EnumToString(a.type), a.raw);
        Printf("BL_ADDR %04X not valid\n", a.raw); // log event
    }
    return s;
}
// }BL_ADDR 


//{BL_HEAD ----------------------------------
typedef struct{
    local DWORD tmp_ptr <hidden=true>;    // for jumping to last block byte
    local uchar is_valid <hidden=true>; // Структура ОБЯЗАНА располагаться на 
    BL_ADDR addr;   // block address
    is_valid = addr.is_valid; // non valid addr -> non valid BL_HEAD
    if(is_valid) is_valid = (addr.offset == FTell()-4);// addr on selfdescribed place
// если нет - это не BL_HEAD     
    if(is_valid){
        SetBackColor(0x00a0f0);    // orange
            //zero_aligment allways  0 hide it
        uchar   zero_aligment <hidden=true, fgcolor=cLtGray>;  
        en_BL_TYPE   type<fgcolor=cDkPurple>;   // type of block
    // `is_compressed` и `uncompressed_size` в carindb_rus всегда = 0, посему скрыты
        uchar   is_compressed <hidden=false, fgcolor=cLtGray>;  
        uchar   uncompressed_size <hidden=false, fgcolor=cLtGray>;
    }else{
        SetBackColor(cRed);    // on error paint in red
        local en_BL_TYPE   type=0xFF;
        DWORD non_valid_bl_head<fgcolor=cLtGray>;
    }
    // отмечу последний байт блока - на него удобно прыгать будет, кликом в Variables
    if(is_valid){
        tmp_ptr = FTell();      // Запомнить текущее положение
        FSeek(addr.offset + addr.size*0x800 - 1); // Уходим на почти конец блока
        uchar here_last_byte <bgcolor=cPurple, fgcolor=cAqua>;     // Самый последний байт блока
        FSeek(tmp_ptr);         // Возврат к запомненной позиции
    }
}BL_HEAD <read = Read_BL_HEAD>;

// Во вкладке Variables в колонку Value вывести строковое значение
string Read_BL_HEAD(BL_HEAD &a){
    local string s;
    if( a.is_valid ){
        SPrintf(s, "tp:%02Xh(%s) of:0x%06X sz=%i ", 
                a.type, EnumToString(a.type), a.addr.offset, a.addr.size);
    }else{
        SPrintf(s, EnumToString(a.type)); // Если признак невалидности - АЛЯРМ! 
        Printf("BL_HEAD %04X not valid\n", a.addr.offset); // log event
    }
    return s;
}
//}BL_HEAD 

//{PTR
typedef struct{
    //SetBackColor(cNone); 
    local uint offset <format=hex>;
	if( exists(parentof(this).size) ){
       if ( ReadUShort(FTell()) > parentof(this).size){
		    SetBackColor(cRed);  // wrong pointer when bigger block size
			Printf("ERR! hex off=%X PTR=0x%04X > block.size 0x%X\n", 
                FTell(),
                ReadUShort(FTell()), 
                parentof(this).size); // Log situation
        }
	}
    if(ReadUShort(FTell())){
	    ushort ptr <format=hex,  fgcolor=cBlue>;        // relative offset pointer value
    }else{
        ushort ptr <format=hex,  fgcolor=cSilver>; // 00 00
    }
//local uint offset = parentof(this).offset + ptr;
    if(ptr){        // do if ptr != 0
        if( exists(parentof(this).offset) ){ // absolute block begin offset
            offset = parentof(this).offset;
            if( (parentof(this).offset + ptr) < MAX_FILE_ADDR-1){
                local DWORD curr_position <hidden=true> = FTell();
                FSeek(parentof(this).offset + ptr); // jump to calc addr
                    byte here <bgcolor=cAqua>;          // make bookmark
                FSeek(curr_position);               // return 
                offset += ptr;
            }else{
                Printf("ERR offset PTR! hexoff=%X PTR %04X PTR.offset=0x%04X > file.size 0x%X\n", 
                    FTell(), ptr, (offset + ptr), MAX_FILE_ADDR);
            }
            
        }
    }
}PTR <read = Read_PTR, bgcolor=cAqua>;
string Read_PTR(PTR &a){
	local string s;
	SPrintf(s, "0x%04X", 
            a.ptr      // value, relative offset
            );
    if( exists(parentof(this).offset) )
        SPrintf(s, "%s (0x%04X)", s,
            parentof(a).offset + a.ptr); // absolute address
	return s;
}
//}PTR

// {LIST - список указатель на начало массива и количество элементов 
typedef struct{
	local uint offset <format=hex>, size <format=hex>;   // block offset and size for next PTR ptr
    if( exists(parentof(this).offset) ){
        offset = parentof(this).offset; // start block offset 
    }
    if( exists(parentof(this).size) ){
        size = parentof(this).size; // parent block size 
    }
	PTR 	ptr <bgcolor=cLtAqua>;	// ptr to first list item
	offset = ptr.ptr + offset;	// absolute addr of list begin
	ushort	cnt <>; // items quantity
}LIST <read=Read_LIST, fgcolor=cDkPurple, bgcolor=cLtAqua>;
string Read_LIST(LIST &a){
	local string s;
	SPrintf(s, "0x%04X (0x%04X)  :cnt:%i(%Xh)", 
        a.ptr.ptr, a.offset, a.cnt, a.cnt );
	return s;
}
//}LIST

//{FAR_LIST
typedef struct{
    BL_ADDR far_block; // link to block type 0xd
    local ushort size <hidden=false>  = far_block.r_size;
    local uint   offset <hidden=true> = far_block.offset;
    LIST    pl_data <bgcolor=0x22BFFF>;  // far pointer list, BL_ADDR+LIST
}FAR_LIST <read=Read_FAR_LIST>;
//C07000+774=C07774 cnt=24(18h); 00180E08 :0Fh(CH_idx_f) sz=8 of:0x00C07000
string Read_FAR_LIST (FAR_LIST &a){
    local string s;
    SPrintf( s, "block(0x%06X); // [%i] tp:%s(%02X) of:%06X",
        a.far_block.raw, a.pl_data.cnt, 
        EnumToString(a.far_block.type), a.far_block.type,
        a.pl_data.offset
        );
    return s;
}
//}FAR_LIST


//}PSTR
// pointer to string
typedef struct{
    local uint offset <hidden=false, format=hex>;   // absolute block offset for next PTR ptr
    if( exists(parentof(this).offset) ){
        offset = parentof(this).offset; // start block offset 
    }
    if(ReadUShort(FTell())){
	    ushort ptr <format=hex,  fgcolor=cDkGreen>;        // relative offset pointer value
    }else{
        ushort ptr <format=hex,  fgcolor=cSilver>; // 00 00
    }
    if(ptr){ // theoreticaly may==0, in this case no need calculate any vars
        offset = ptr + offset;                // set own absolute offset 
        if(offset){ // shoulb be not zero
            local uint curr_position <format=hex, hidden=true> = FTell(); // remember ret
            FSeek(offset);          // jmp to offset
                // first byte - ascii or ptr?
                ubyte here <bgcolor=cAqua>;
                FSeek(FTell()-1);
                //if( here > 20h){
                    string str <bgcolor=cLtGreen, fgcolor=cDkYellow>; // str as real
                /*}else{
                    local uint ret_here <hidden=true> = FTell(); // remember ret
                    FSeek( ReadUShort(FTell()) + offset);
                        string str <bgcolor=cLtGreen, fgcolor=cDkYellow>;
                    FSeek(ret_here);
                }*/
            FSeek(curr_position);   //ret
        }else{
            local string str;  // str as local
            SPrintf(str, "PSTR No offset %04X", ptr);
        }
    }else{ // if(ptr.ptr == 0, aniway str must be
        local string str="---";
    }
}PSTR <read=Read_PSTR,bgcolor=cLtAqua>;
string Read_PSTR(PSTR &a){
    local string s;
	SPrintf(s, "%s", a.str);
	return s;
}
//}PSTR


//{CONST_B
typedef struct(ubyte val){
    local uchar is_valid <hidden=true> = 1;
    local ubyte wait_b = val;   // remember init val
    if(ReadUByte(FTell()) != val){
        is_valid = 0;
        SetBackColor(cRed);
        Printf("WARN. 0f:%04X const ubyte(%02Xh) != %Xh\n", 
            FTell(), wait_b, ReadUByte(FTell()));
    }
    ubyte value;
}CONST_B <fgcolor=cWhite, bgcolor=cGray, hidden=true, read=Read_CONST_B>;
string Read_CONST_B(CONST_B &a){
    local string s;
    if(a.is_valid){
        SPrintf(s, "ubyte= %X", a.value);
    }else{
        SPrintf(s, "WARN! ubyte %X != %X", a.value, a.wait_b);
    }   
    return s;
}
//}CONST_B
//{CONST_S
typedef struct(ushort val){
    local uchar is_valid <hidden=true> = 1;
    local ushort wait_s = val;   // remember init val
    if(ReadUShort(FTell()) != val){
        is_valid = 0;
        SetBackColor(cRed);
        Printf("WARN. 0f:%04X const ushort (%04Xh) != %Xh\n", 
            FTell(), wait_s, ReadUShort(FTell()));
    
    }
    ushort value;
    //Assert(value!=val,"asssert");
}CONST_S<fgcolor=cWhite, bgcolor=cGray, hidden=true, read=Read_CONST_S>;
string Read_CONST_S(CONST_S &a){
    local string s;
    if(a.is_valid){
        SPrintf(s, "ushort= %X", a.value);
    }else{
        SPrintf(s, "WARN! ushort %X != %X", a.value, a.wait_s);
    }   
    return s;
}
//}CONST_S
//{CONST_I
typedef struct(uint val){
    local uchar is_valid <hidden=true> = 1;
    local uint   wait_i = val;   // remember init val
    if(ReadUInt(FTell()) != val){
        is_valid = 0 ;
        SetBackColor(cRed);
        Printf("WARN. 0f:%04X const uint (%08Xh) != %Xh\n", 
            FTell(), wait_i, ReadUInt(FTell()));
    }
    uint value;
}CONST_I<fgcolor=cWhite, bgcolor=cGray, hidden=true, read=Read_CONST_I>;
string Read_CONST_I(CONST_I &a){
    local string s;
    if(a.is_valid){
        SPrintf(s, "uint= %X", a.value);
    }else{
        SPrintf(s, "WARN! uint %X != %X", a.value, a.wait_i);
    }   
    return s;
}
//}CONST_I

//{LON_LAT
typedef struct{
    uint    hlon <fgcolor=cYellow>;
    uint    hlat <fgcolor=cWhite>;
    local double lon = ((1.0f * hlon )/ MULCOORD) - 30.0;
    local double lat = 1.0f * hlat / MULCOORD;
}LON_LAT <bgcolor=cDkGreen, read=Read_LON_LAT, comment=Comment_LON_LAT>;
string Read_LON_LAT(LON_LAT &a){
    local string s;
        SPrintf( s, "%06f%s, %06f%s", 
            Abs(a.lat), (a.lat>0)?"N":"S",
            Abs(a.lon), ((a.lon>=0)?"E":"W") );
    return s;
}
string Comment_LON_LAT(LON_LAT &a){
    local string s;
    local ubyte zoom = 19;
    // like https://www.google.com/maps/@54.6184459,18.8018413,15z
    SPrintf(s, "https://www.google.com/maps/@%06f,%06f,%iz",
        a.lat, a.lon, zoom);
    // https://www.openstreetmap.org/#map=17/59.37247/28.18919
    SPrintf(s, "https://www.openstreetmap.org/#map=%i/%06f/%06f",
        zoom, a.lat, a.lon );
    return s;
}
//}LON_LAT


#endif //#ifndef H_VDO_inc_common_INCLUDED