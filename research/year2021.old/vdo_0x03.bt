}BLOCK_TYPE_0x03<read=Read_BLOCK_TYPE_0x03>;
string Read_BLOCK_TYPE_0x03(BLOCK_TYPE_0x03 &a){
    local string s;
    if(a.block.crypted.zero == 0 ) {
    SPrintf(s,"%04X x %04X (scale: 0x%04X); %s", 
//SPrintf(s,"0x%04X (scale: 0x%04X); %i types, %i shapes, %i lines, \tfirst: '%s'...", 
        //a.mb_NumNextLevel, 
        a.map_area.v_size, a.map_area.h_size, a.map_area.scale,
        EnumToString(a.block.type)
        //a.block.data.Cnt, 
        //a.p_all_poligons.Cnt, a.p_all_lines.Cnt, 
        //a.geo_type[0].object[0].name
        );
    }else{
        SPrintf(s, "cr: 0x%04X", a.block.crypted.zero);
    }
    return s;
}  

