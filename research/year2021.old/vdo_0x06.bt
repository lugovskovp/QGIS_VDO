#ifndef H_VDO_0x06_INC_INCLUDED
#define H_VDO_0x06_INC_INCLUDED

//00 95 8E:01 06__POLI_1 - scale[1]
// list of poi_0x10 type pointers


#include "vdo_inc.bt"


//}BLOCK_TYPE_0x06
typedef struct{
//header start
    BL_HEADER   block;
    PTR_CNT     unkn;
    geo_area    map_area;   //LON_LAT     bottom_left, top_right;
// header end, last = 0Ch -1 

struct{
    BL_ADDR poi_0x10;

DWORD unkn1;

    WORD   unkn01;
    CONST_WORD  unkn_01(0x30);
    ZERO_WORD   unkn01;
    CONST_WORD  unkn_01(0x01);
    ZERO_DWORD unkn4;
    ZERO_DWORD unkn5;
    ZERO_DWORD unkn6;
}bl_0x06_data [block.data.Cnt] <optimize = false>;

}BLOCK_TYPE_0x06 < read=Read_BLOCK_TYPE_0x06, 
    comment=Comment_block0x06 >;
string Comment_block0x06(BLOCK_TYPE_0x06 &a){
    return Comment_BL_ADDR(a.block.addr);
}
string Read_BLOCK_TYPE_0x06(BLOCK_TYPE_0x06 &a){
    local string s;
    //SPrintf(s, "%i of %i; %ix%i;   Size: %f degr", a.map_files_cnt,  
    //    a.block.data.Cnt, a.sq_size, a.sq_size, a.deg_size);
    SPrintf(s, "(scale: %02Xh) %s; [%i] poi_0x10 :\t %s - %s", 
        a.map_area.scale,
        EnumToString(a.block.type),
        a.block.data.Cnt, 
        Read_LON_LAT(a.map_area.bottom_left), Read_LON_LAT(a.map_area.top_right) 
        );
    return s;
}


#endif //H_VDO_0x06_INC_INCLUDED