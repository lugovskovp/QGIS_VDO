/*
In the car driver can chouse "Map scale"
10m 20m 100m 200m 500m 1km 2km 5km 10km 50km 100km
cnt=11
*/


typedef struct{
    BL_ADDR bl_almanac;  //scale_list_maps;
    local DWORD folder_side_size <format=hex> = 0;
    local WORD  qty_in_side_almanac <format=hex> = 0;
    local WORD  qty_folders = 0;
    if(bl_almanac.offset){ 
        folder_side_size = ReadUInt(bl_almanac.offset + 0x0c);
        qty_folders      = ReadUShort(bl_almanac.offset + 0x0A); 
        LON_LAT  world_bot_left, world_top_right;
        if(folder_side_size>0)
                //world_size 
                qty_in_side_almanac =  ( world_top_right.hlat - world_bot_left.hlat)
                         / folder_side_size;
        
        DWORD _MB_SCALE <fgcolor=cRed>;
        if(file_version == 1){
            
            WORD _MB_SCALE_too <fgcolor=cRed>;
            ZERO_WORD blank;
        }else{
            local WORD _MB_SCALE_too = 0;
        }
    }else{
    //scale_list_maps = 0000000
        DWORD MB_La_1 <fgcolor=cGray>, MB_Lo_1 <fgcolor=cGray>, 
            MB_La_2 <fgcolor=cGray>, MB_Lo_2 <fgcolor=cGray>;
        DWORD _MB_SCALE  <fgcolor=cGray>;
        if(file_version == 1){
            WORD _MB_SCALE_too  <fgcolor=cGray>;
            ZERO_WORD blank;
        }else{
            local WORD _MB_SCALE_too = 0;
        }
    }  
}SCALE <read=Read_SCALE>;
string Read_SCALE(SCALE &a){
    local string s;
    if(a.qty_folders == 0) return ("---");
    SPrintf(s, "%04X %04x    %04X | side: 0x%04Xk, %ix%i \tfolders: %i", 
        (a._MB_SCALE >> 16),
        (a._MB_SCALE & 0xffff),
        a._MB_SCALE_too,
        (a.folder_side_size / 1024),
        a.qty_in_side_almanac, a.qty_in_side_almanac,
        a.qty_folders
);
    return s;
}
