//}BLOCK_TYPE_0x07
typedef struct{
local USHORT i <hidden=true>;
// only here i find different between 0A addinfo fields count
// 1 - new, 2 - old, non-crypted
local WORD file_version = ReadUShort(0x2e);
// header begin
    BL_HEADER   block;
    //_0x18_block and str name some maps countries
    PTR_CNT  p_country_terr_divisions <bgcolor=cLtYellow>;   
    if(file_version == 1){
        PTR_CNT  p_10_idx_countryes  <bgcolor=cLtYellow>;
    }
// header end
//locals

local DWORD world_size <format=hex>, world_size_h <format=hex>;
//
// fill data
/*
In the car driver can chouse "Map scale"
10m 20m 100m 200m 500m 1km 2km 5km 10km 50km 100km
*/
    struct{
        SCALE   scale[12] <optimize=false>;
    }__scales; 
    world_size = __scales.scale[0].world_top_right.hlat 
                        - __scales.scale[0].world_bot_left.hlat;
/*    world_size_w =   __scales.scale[0].MB_La_2.value -
            __scales.scale[0].MB_La_1.value;
    world_size_h =   __scales.scale[0].MB_Lo_2.value -
            __scales.scale[0].MB_Lo_1.value;
*/  
    UNKN xx01;
    ZERO_DWORD zero_xx;
    UNKN xx02;

    PTR  p_const_last_in_bl_data_202a;
    jmpp(p_const_last_in_bl_data_202a);
        CONST_WORD last_word_in_data(0x202a);
    ret();
    ZERO_WORD s;
//DWORD _end <bgcolor=cAqua>;
//BL_ADDR try;

struct{
//jmp(block.data);
    struct{
        WORD    understanded_main_data <fgcolor=cRed>;
        PTR     p_zero_char;
        ZERO_WORD   blank;
        jmpp(p_zero_char);
            char zero_char <bgcolor=cLtAqua>;
        ret();
    }__main_data[block.data.Cnt] <optimize=false>;
//ret();
}__main_data;


//PTR_CNT  p_0c_str_0x18_block <bgcolor=cLtYellow>;
if(p_country_terr_divisions.Cnt){
//jmp(p_0c_str_0x18_block);
    struct {
        BL_ADDR    bl_idx_terr_division;
        WORD    eq_08_scale_list_addinfo <fgcolor=cDkGreen, bgcolor=cLtGreen>;
        WORD    mb_cnt <fgcolor=cRed>;
// MB FAR_PTR_CNT
        PTR     p_str_name <bgcolor=cLtGreen>; //, optimize=false>;

WORD    mb_geo_type_country_100 <bgcolor=cLtBlue, fgcolor=cYellow>;
        WORD    w_country_idx_num <fgcolor=cDkAqua, bgcolor=cLtYellow>; 
// AFTER ARRAY p_0c.p_try.Cnt == w_country_idx_num
        ZERO_WORD   w_z;
        PTR_CNT     _0x18_block1;
        local DWORD l_tmp <hidden=true> = FTell(); 
        FSeek(p_str_name.offset);
        string __str_name <bgcolor=cLtGreen>;
        FSeek(l_tmp);
    }__country_territorial_division [p_country_terr_divisions.Cnt] <optimize=false>; 
    for(i=0; i<p_country_terr_divisions.Cnt; i++) 
        CONST_WORD __maps_countries_array_0c( 
            __country_territorial_division[i].w_country_idx_num);
//ret();
} //if(p_0c_str_0x18_block.Cnt){

if(file_version == 1){
//jmp(p_10_idx_countryes);
    struct {
        WORD w_country_idx_num <fgcolor=cDkAqua, bgcolor=cLtYellow>;
        CONST_DWORD _01f4012c(0x01f4012c);
        CONST_DWORD _03e8f401(0x03e8f401);
        ZERO_WORD  blank;
        WORD   _0_or_1 <fgcolor=cRed>;;
        CONST_WORD fff(0xffff);;
        ZERO_DWORD  blankw; 
        ZERO_WORD  blankw; 
    } _10_idx_countryes [p_10_idx_countryes.Cnt] <optimize=false>;
//ret();
} //if(p_0c_str_0x18_block.Cnt){








//header end


}BLOCK_TYPE_0x07<comment=Comment_block0x07,read=Read_BLOCK_TYPE_0x07 >;
string Comment_block0x07(BLOCK_TYPE_0x07 &a){
    return Comment_BL_ADDR(a.block.addr);
}
string Read_BLOCK_TYPE_0x07(BLOCK_TYPE_0x07&a){
    local string s;
    SPrintf (s, "0x%08X wide", a.world_size);
    
    return s;
}

