//pADD_INFO_ROAD;

typedef struct{
        local WORD length;
        switch(block.type){
        case 0x0A:    
            length = p_add_info.Cnt;// <hidden=true>;
            pADD_INFO_COUNTRY  info[length]<optimize=false>;
            break;
        case 0x0C:
            
        default:
            length = p_add_info.Cnt;// <hidden=true>;
            pADD_INFO_CITY  info[length]<optimize=false>; 
            break;
        }
}LIST_pADD_INFO <read=Read_LIST_pADD_INFO>;
string Read_LIST_pADD_INFO(LIST_pADD_INFO &a){     
    local string s;
    SPrintf(s, "count = [%i]", a.length);
    return s;
}



// --------------
// main data of 0A.
typedef struct{
//rec start
    PTR    p_str_name;
    en_GEO_TYPE     geo_type <format=hex>;
    en_GEO_COUNTRY  mb_geo_subtype  <format=hex,bgcolor=cLtRed>;
    PTR     p_str_parent_name;  //in 0x0a ZERO_WORD   blank <fgcolor=cLtGray>;
    PTR     p_add_info <fgcolor=cDkGreen, bgcolor=0x008CFF>;
//rec end

// data on ptr`s
    //
    local DWORD l_tmp <hidden=true> = FTell();
    FSeek(p_str_name.offset);
        string name <bgcolor=cLtGreen>;
    //
    FSeek(p_add_info.offset);
    switch(block.type){
    case 0x0A:    
        pADD_INFO_COUNTRY  add_info;
        break;
    case 0x0C:
        pADD_INFO_CITY  add_info;
        break;
    default:
        pADD_INFO_CITY  add_info;
        //pADD_INFO_ROAD  add_info; 
        break;
    }
    //
    if(p_str_parent_name.Ptr);
        FSeek(p_str_parent_name.offset);
        string parent_name <bgcolor=cGreen>;
    FSeek(l_tmp);
}pTEXT_INFO <read = Read_pTEXT_INFO, comment=Comment_pTEXT_INFO>;
string Read_pTEXT_INFO(pTEXT_INFO &a){
    local string s;
    SPrintf(s, "%02X-%02X (%s) %s ", a.geo_type, a.mb_geo_subtype, 
             a.parent_name, a.name);
    return s;
}
string Comment_pTEXT_INFO(pTEXT_INFO &a){
    local string s;
    SPrintf(s, " %s", Comment_BL_ADDR(a.add_info.p_ch_list.far_block_addr));
    return s;
}

typedef struct{  
        local WORD length = block.data.Cnt;// <hidden=true>;
        pTEXT_INFO  info[block.data.Cnt]<optimize=false>;  
}LIST_pTEXT_INFO <read=Read_LIST_pTEXT_INFO>;
string Read_LIST_pTEXT_INFO(LIST_pTEXT_INFO &a){     
    local string s;
    SPrintf(s, "count = [%i]", a.length);
    return s;
}
