//header start
    BL_HEADER  block;
    PTR_CNT     p_geo_info; // 0A->_0D_ch_idx_files
    ZERO_DWORD  p_map_data;
    PTR_CNT     p_ch_POI;   //p_list_idx_0x11 c 0x5800 0x0c block, notBL_ADDR
    ZERO_DWORD  blank01;
    PTR_CNT     MB_coordinates <comment="0x0A=0">;//1F84h
    BL_ADDR      try_neightboard <comment="zero 0x0A, ee0x0C 000024=0">; // 00 13 07 -9800h - 0C_regionList
    UNKN  blank03 <comment="zero 0x0A, ee0x0C=0 ru0C=5f48 03c2">;
    ZERO_DWORD     next_0A; // <comment="zero 0x0A, ee0x0C 000024=0x2a08">;
    ZERO_DWORD     prev_0A;  //bl_a_0c_0c
// -------------- fill data
    struct {
        GEO_PLACE   place[block.data.Cnt] <optimize=false>;
    } places;
    struct {   
            GEO_INFO_COUNTRY geo_info[p_geo_info.Cnt] <optimize=false>;
    } geo_info;
//if p_ch_POI
    struct {
        P_POI list_ch_poi [p_ch_POI.Cnt] <optimize=false>;
    }POIs;
}BLOCK_TYPE_0x0A <comment=Comment_block0x0A >;
string Comment_block0x0A(BLOCK_TYPE_0x0A &a){
    return Comment_BL_ADDR(a.block.addr);
}


