// --- GEO_PLACE
// main data of 0A.
typedef struct{
    GEO place <optimize=false>;;
    local DWORD l_geo_tmp <hidden=true> =FTell();
    //local DWORD ofss = places.place.place.p_geo_info.offset;
    FSeek(places.place.place.p_geo_info.offset);
        GEO_INFO_COUNTRY  __geo_info;
    FSeek(l_geo_tmp);
}GEO_PLACE  <read = Read_GEO_PLACE, optimize=false>; //,  comment=Comment_GEO_PLACE>;
string Read_GEO_PLACE(GEO_PLACE &a){
    local string s;
    SPrintf(s, "%s (%s) %s", Read_GEO(a.place),
             a.place.parent_name, a.place.name);
    return s;
}
 

typedef struct{
