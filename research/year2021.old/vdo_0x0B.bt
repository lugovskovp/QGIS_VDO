//--- 010 Editor v8.0.1 Binary Template

#ifndef H_VDO_0x0B_INC_INCLUDED
#define H_VDO_0x0B_INC_INCLUDED


// types 0B, 0D, 0F, 11


#include "__place.bt"



typedef struct{
//header start
    BL_HEADER       block;
// header end, last = 0Ch -1 
    SYMBOL symbol[block.data.Cnt] <optimize=false>;
}BLOCK_TYPE_0x0B <read=Read_block0x0B_content, comment=Comment_block0x0B>;
string Read_block0x0B_content(BLOCK_TYPE_0x0B &a){
    local string s="";
    local UINT i;
    for(i=0; i<a.block.data.Cnt; i++){
        SPrintf(s, "%s %s", s, a.symbol[i].ch );
    };
    SPrintf(s, "[%i] %s", a.block.data.Cnt, s);
    return s;
}
string Comment_block0x0B(BLOCK_TYPE_0x0B &a){
    return Comment_BL_ADDR(a.block.addr);
}




