}GEO_CITY  <read = Read_GEO_CITY>; //,  comment=Comment_GEO_PLACE>;
string Read_GEO_CITY(GEO_CITY &a){
    local string s;
    SPrintf(s, "%02X-%02X (%s) %s ", a.place.type_obj, a.place.en_country, 
             a.place.parent_name, a.place.name);
    return s;
}
 

