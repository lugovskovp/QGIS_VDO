string Read_PLACE(PLACE &a){
    local string s;
    SPrintf(s, "%s, %s, %s %s %s %s", 
        Read_GEO(a.geo), Read_LON_LAT(a.info.coord),
        a.info.p_post_addr_street.str, a.info.p_post_addr_city.str,
        a.info.p_post_addr_region.str, a.info.p_post_addr_country.str 
    );
    return s;
}



