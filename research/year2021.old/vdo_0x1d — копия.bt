        local struct BIN_BUFFER buff; // 8 first coded Types after seems_useless
        buff.ptr = FTell();
        buff.raw =  ReadUQuad(buff.ptr);
        buff.akk_shift = 0;
        //------ 1. list of types
    
            //calc addr_sh
        local DWORD tmp_start_ptr = buff.ptr;   // for end coloring
        local unsigned byte addr_sh=0;  // 19 bits len compressed type
        if ( ((buff.raw>> (64-20) & 0xff ))<<1 == head.p_all_shapes.Ptr ) addr_sh = 1;    // 20  bits len compressed type
        if ( ((buff.raw>> (64-20) & 0xff ))<<2 == head.p_all_shapes.Ptr ) addr_sh = 2;    // 21  bits len compressed type
//Printf("addr_sh = %i, b:%X o:%X\n", addr_sh, (buff.raw>> (64-20) & 0xff ), head.p_all_shapes.Ptr);
            // uncompress types
        local unsigned DWORD tmp<format=hex, hidden=true>, val<format=hex, hidden=true> =0;
//Printf("\n");
        struct{
            for (i=0; i <= block.data.Cnt; i++){
//pbn(buff);
                        // type
                    tmp = pull_bits(buff, 7);    //
                    val = tmp << 24;
                    // is_line
                    tmp = pull_bits(buff, 1);
                    val |= tmp<<16;
                    //offset             
                //0 >>1, r12<<1
                //1 r12 <<1
                //2 r12 <<2            
                    tmp = pull_bits(buff, 11+addr_sh);
                //if(!addr_sh) tmp <<=1;  // bl 0x053d7e, no shift
                tmp <<= 1;
                //Printf(" tmp==%04X shifted=%04X", tmp, tmp<<addr_sh); 
                val |= tmp;
                //Printf(" pulled  %i %08X \n", i,  val);
                local struct C_GEO_TYPE geo_type;
                geo_type[i].type = val >>24;
                geo_type[i].is_line = (val >>16) & 0xf;
                geo_type[i].p_type_obj.Ptr = val & 0xffff;
                if(i){ // fill p_next_type_obj and obj count of prev geotype
                    geo_type[i-1].p_next_type_obj.Ptr = geo_type[i].p_type_obj.Ptr;
                    if(geo_type[i-1].type != 0){
                        if(geo_type[i-1].is_line){
                            geo_type[i-1].obj_cnt = ( geo_type[i-1].p_next_type_obj.Ptr - geo_type[i-1].p_type_obj.Ptr ) / 10h;
                        }else{
                            geo_type[i-1].obj_cnt = ( geo_type[i-1].p_next_type_obj.Ptr - geo_type[i-1].p_type_obj.Ptr ) / 14h;
                        }
                    }
                }
            }
        byte COMPRESSED_GEO_TYPES[buff.ptr-tmp_start_ptr+1] <bgcolor=cBlue, fgcolor=cLtRed>;
        }all_types;
        //--- all poligons
                /*    shape
                2h - ptr2str/0; 
                2h - ptr2vertexes (first=first vert)
                4h - id [0000 7685]
                8h - LON_LAT
                2h = 00 00 - aligment
                2h - ptr2 list strPtr
                */
        tmp_start_ptr = buff.ptr;
        // make empty shape array with last tail
        struct{
            
        
        // fill  shape array itemp
    Printf("ul:%08X ------ [%08X %08X]\n", seems_useless, head.map_area.bottom_left.hlon, head.map_area.bottom_left.hlat);
local unsigned WORD tmp_qty_bits = 18 - ( (seems_useless >>8) & 0xff) ;
local unsigned WORD pstr_qtybits, vrtx_qtybits, vrtx_bits, id_qtybits;
local unsigned DWORD tmp_show; 


// 1 calc vrtx_qtybits
tmp_show = show_bits(buff, 32);     //get 32 first buff bits
tmp_show <<= 12;                // skip pstr bits

vrtx_qtybits = 1;
do{
    tmp_show <<=1;
    vrtx_qtybits ++;
//Printf("vq=%i %X\n" , vrtx_qtybits, tmp_show);
}while( ( (tmp_show & 0x80000000) != 0x80000000) && vrtx_qtybits < 21);
// 2 calc pstr_qtybits
if(vrtx_qtybits < 16){
