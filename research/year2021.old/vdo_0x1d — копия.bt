typedef enum<WORD>{
    scale_40    =   6h,
    scale_80    =   7h,
    scale_100   =   8h,
    scale_200   =   9h,
    scale_400   =   0ah,
    scale_667   =   0bh
}en_SCALES <format=hex, bgcolor=cDkGreen, fgcolor=cAqua>;


typedef struct{
     local DWORD  first_type_sea<format=hex> = 0x0100;
    local DWORD   off_sea= parentof(this).p_all_shapes.Ptr;
}should_be<read=Read_should_be>;
string Read_should_be(should_be &a){
    local string s;
    SPrintf(s, "%02X %02X %02X %02X", 
        (a.first_type_sea>>8), (a.first_type_sea&0xff) ,
        (a.off_sea>>8), (a.off_sea&0xff)
        );
    return s;
}


typedef struct{
        WORD type <bgcolor=cLtYellow>;
        //GEO_VERTEX xy;
    WORD m;
    WORD n;
}mb_poi<read=Read_mb_poi>;
string Read_mb_poi(mb_poi &a){
    local string s;
    SPrintf(s, "%04X %04X %04X", a.type , a.m, a.n);
    return s;
}



typedef struct(local DWORD v){
    local DWORD raw <format=hex, hidden=false> = v;
    local en_GEO_OBJ_TYPE type = raw >>24;
    local en_MAP_SHAPE_TYPE is_line = (raw >>16) & 0x00ff;
    local WORD p_type_obj<format=hex> = raw & 0x0000ffff;   // ptr to start objs
    local WORD cnt = 0;                                     // object`s count
}l_geo_type <read=Read_l_geo_type>;
string Read_l_geo_type(l_geo_type &a){
        local string s;
    SPrintf(s, "->0x%04X %s; [%i] off: 0x%04X", 
        (a.raw >>16), EnumToString(a.type), 
        a.cnt, a.p_type_obj);
    return s;
}

DWORD unarc_geo_type(DWORD buf, WORD len){
//return 0x6a017891;
    local unsigned DWORD res;
    // Printf(" :[%05X] \t", buf );
        // ### 1 type
    local WORD type = (buf >> (len-8) ) <<7; 
    type = (type & 0xff00) | (type & 0x00FF)>>7;
//    Printf(" %04X", type );
        // ### 2 addr
    local WORD val = (buf &0x00000FFF) <<1;
    //val <<=1;
//    Printf(" %04X ", val );
//    if(type == 0) Printf("<---\n"); // last, 0000 xxxx <-ptr2str-10h
    res = type;
    res <<= 16;
    res |= val;
//    Printf(" =%08X= ", res );
    return res;
}


//*************************************
//-----------------------------------
typedef struct{
        local DWORD         ptr<format=hex>; // 8 first coded Types
        local unsigned QUAD raw<format=hex>;    // binary LIFO
        local unsigned byte akk_shift;          // akkumulated shift of real bytes ptr
}BIN_BUFFER;

// load more NEXT BITS in the buffer
void refill_buff(BIN_BUFFER &buffer, WORD bits_qty ){
    local unsigned QUAD  buf_t<format=hex>;     // temp buff
//    local unsigned byte sss;                    // rshifting buf_t
    // bits_qty MUST be less 64
    if(bits_qty > 64){
        break; //err!!!
    }
    // calculate pointer for buf_t
    buffer.ptr +=  bits_qty>>3;        // qty bytes in bits
    buffer.akk_shift += (bits_qty % 8);// 
    if(buffer.akk_shift >= 8){
        buffer.akk_shift -=8;
        buffer.ptr++;
    } 
//     Printf("\n s:%i f:ptr=%08X akk=%i tmp_b:", (bits_qty % 8), ptr+1, akk_shift);
    buf_t = ReadUQuad(buffer.ptr+1);     // Print_buf(buf_t);
    buf_t >>= 8 - buffer.akk_shift ;     // Printf("shifted:"); Print_buf(buf_t); Printf(":\n");
    buffer.raw |= buf_t; 
}

// global LIFO buffer - getting bits from head
unsigned DWORD pull_bits(BIN_BUFFER &buffer, WORD bits_from_head_buff ){
    local unsigned DWORD val;
    val = buffer.raw >> (64 - (bits_from_head_buff ) );
    // Printf (" gb val = %X", val); 
    buffer.raw <<= bits_from_head_buff;
    refill_buff(buffer, bits_from_head_buff);   // read equal qty next bits
    return val;
}
unsigned DWORD show_bits(BIN_BUFFER &buffer, WORD bits_from_head_buff ){
    local unsigned DWORD val;
    val = buffer.raw >> (64 - (bits_from_head_buff ) );
    return val;
}

void pb(BIN_BUFFER &buffer){
    Printf(" %08X %08X ", buffer.raw >>32, buffer.raw & 0xffffffff);
}
void pbn(BIN_BUFFER &buffer){
    Printf(" %08X %08X (%08X%08X>>%i)\n", buffer.raw >>32, buffer.raw & 0xffffffff,
        (buffer.raw >> buffer.akk_shift)>>32, 
        (buffer.raw >> buffer.akk_shift) & 0xffffffff, buffer.akk_shift
    );
}
