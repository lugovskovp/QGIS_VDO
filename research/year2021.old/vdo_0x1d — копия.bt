//07h scales[i-off32h:scale]:  5(9:200h)-0x14 6(7:80h)-0x15 7(6:40h)-0x16 
                           //  9(8:100h)-0x1c a(a:400h)-0x1d b(b:666h)-0x1e 
typedef struct{
    local WORD i <hidden=true>, k <hidden=true>; // cycles counter
//header start
    BL_HEADER   block;          // block.data - list of geo_types
    struct{
            PTR_CNT     p_all_shapes <bgcolor=cLtYellow>;
