    }
    // header end, last = 0Ch -1 
} BLOCK_TYPE_0x1d < read=Read_BLOCK_TYPE_0x1d, 
    comment=Comment_block0x1d >;

string Comment_block0x1d(BLOCK_TYPE_0x1d &a){
    return Comment_BL_ADDR(a.block.addr);
}
string Read_BLOCK_TYPE_0x1d(BLOCK_TYPE_0x1d &a){
    local string s;
    if(a.block.is_compressed == 0 ) {
        SPrintf(s, ":%i: %s [%Xx%X]  %i types, %i shapes, %i lines", 
            a.block.addr.size,
            EnumToString(a.block.type),
            a.head.vrtx_max_x, a.head.vrtx_max_y,
            a.block.data.Cnt, 
            a.head.p_all_shapes.Cnt, a.head.p_all_lines.Cnt
        );

    }else{
        SPrintf(s, "::%i->%i:: %s  [%Xx%X] ; %i types, %i shapes, %i lines",
            a.block.addr.size, a.block.length_unpack,
            // EnumToString(a.head.en_scale),
            //a.head.map_area.scale,
            EnumToString(a.block.type), 
            a.head.vrtx_max_x, a.head.vrtx_max_y,
            a.block.data.Cnt, 
            a.head.p_all_shapes.Cnt, 
            a.head.p_all_lines.Cnt
        );
    }
    return s;
}

