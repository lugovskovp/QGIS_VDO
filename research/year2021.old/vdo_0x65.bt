//------------------------------------------------
//--- 010 Editor v8.0.1 Binary Template

#ifndef H_VDO_0x65_INC_INCLUDED
#define H_VDO_0x65_INC_INCLUDED

/*
Carinet

00000000: 00000001 :  66 cnt- 0001
00000800: 00000108 :  64 cnt- 0002
00005000: 00000A08 :  65 cnt- 0049
*/

#include "vdo_inc.bt"





typedef struct{
    WORD        code <bgcolor=cLtAqua, fgcolor=cBlue>;
    PTR_string  pstr;
}main_data65 <read = Read_data65>;
string Read_data65(main_data65 &a){
    local string s;
    SPrintf(s, "%04X: %s",  a.code, a.pstr.str);
    return s;
}



//////////////////////////
typedef struct{
//header start
    BL_HEADER   block;
    BL_ADDR     next_65;
    BL_ADDR     prev_65;
    en_CARINET_LANGUAGE   en_language <bgcolor=cBlue, fgcolor=cYellow>;
    uchar   zero <fgcolor=cLtGray>;
    ZERO_WORD z2;
 // header end, last = 0Ch -1    


    main_data65 data[block.data.Cnt]<optimize = false>;


}BLOCK_TYPE_0x65 < read=Read_BLOCK_TYPE_0x65, 
    comment=Comment_block0x65 >;
string Comment_block0x65(BLOCK_TYPE_0x65 &a){
    return Comment_BL_ADDR(a.block.addr);
}
string Read_BLOCK_TYPE_0x65(BLOCK_TYPE_0x65 &a){
    local string s;
    SPrintf(s, "%02X%s: %04X-%04X", 
        a.en_language, EnumToString(a.en_language),
        a.data[0].code, a.data[a.block.data.Cnt-1].code); 
    //    a.block.data.Cnt, a.sq_size, a.sq_size, a.deg_size);
    return s;
}


#endif //H_VDO_0x65_INC_INCLUDED