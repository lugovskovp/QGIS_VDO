//------------------------------------------------
//--- 010 Editor v8.0.1 Binary Template

#ifndef H_VDO_0x66_INC_INCLUDED
#define H_VDO_0x66_INC_INCLUDED

#include "vdo_inc.bt"

/*
Carinet
https://en.wikipedia.org/wiki/Radio_Data_System

00000000: 00000001 :  66 cnt- 0001
00000800: 00000108 :  64 cnt- 0002
00005000: 00000A08 :  65 cnt- 0049
*/



typedef struct{
    BL_ADDR     bl_native_mess;
    local WORD  code_from = ReadUShort(FTell()-8);
    code_from++;
    code_from = code_from & 0x07ff;
    WORD        code_till <bgcolor=cLtAqua, fgcolor=cDkGreen>;
    en_CARINET_LANGUAGE lang <bgcolor=cBlue, fgcolor=cGreen>;
    uchar   zero <fgcolor=cLtGray>;
    
}P_NATIVE_MESS <read=Read_P_NATIVE_MESS>;
string Read_P_NATIVE_MESS(P_NATIVE_MESS &a){
    local string s;
    SPrintf(s, "%04X-%04X, %02X%s bl: 0x%08X", a.code_from, a.code_till,
        a.lang, EnumToString(a.lang), a.bl_native_mess.hex);
    return s;
}


typedef struct{
//header start
    BL_HEADER   block;  // data - block_type_64 list
    PTR_CNT     ptr65_native_lang_mess;
    PTR_CNT     ptr_carinet_block_types;
    PTR_CNT     ptr_add_info2;
    DWORD       unkn0x00030000   ;
// header end, last = 0Ch -1 

// fill data
    struct{
        BL_ADDR     bl_type_64;
        WORD        code_till <bgcolor=cLtAqua, fgcolor=cDkGreen>;
        ZERO_WORD   zero;
    }bl_type64[block.data.Cnt + 1] <optimize = false>;
    // !!! Cnt+1, last bl - zeroed, seems part addr used as max val for prev

    P_NATIVE_MESS native_lang_messages[ptr65_native_lang_mess.Cnt + 1] <optimize = false>;

    WORD carinet_block_types[ptr_carinet_block_types.Cnt] <bgcolor=cBlue, fgcolor=cYellow>;

    struct{
        WORD    number <fgcolor=cBlue>;
        WORD    value <bgcolor=cLtAqua>;
    }add_info2[ptr_add_info2.Cnt] <optimize = false>;

}BLOCK_TYPE_0x66 < read=Read_BLOCK_TYPE_0x66, 
    comment=Comment_block0x66 >;
string Comment_block0x66(BLOCK_TYPE_0x66 &a){
    return Comment_BL_ADDR(a.block.addr);
}
string Read_BLOCK_TYPE_0x66(BLOCK_TYPE_0x66 &a){
    local string s;
    //SPrintf(s, "%i of %i; %ix%i;   Size: %f degr", a.map_files_cnt,  
    //    a.block.data.Cnt, a.sq_size, a.sq_size, a.deg_size);
    return s;
}


#endif //H_VDO_0x66_INC_INCLUDED



