// Types of DATA BLOCKS
//en_BL_DATA_TYPE
typedef enum <WORD> { 
    _0x00_DATA_     = 0h,       // ** examle: 0x10a01000 021402:09
    _BIT_MASK        = 04h,   
    _LST_WORLD_SCALES   = 07h,
    _SCALE_ALMANAC      = 08h,     //
    _FOLDER_MAPS      = 09h,     //   list of 
    //_MAP_POLI_number_in_0x07_scale_array
    __POLI_1         = 06h,       // **
    __POLI_2         = 1h,       // **
    __POLI_3         = 2h,       // **
    __POLI_4         = 3h,       // **
    _MAP_POLI_5_k200    = 14h,     //**  k=200
    _MAP_POLI_6_k80     = 15h,     //**  k=80
    _MAP_POLI_7_k40     = 16h,     //**  k=40
    _MAP_POLI_9_k100    = 1Ch,     //** k=100
    _MAP_POLI_10_k400   = 1Dh,     //**  k=400
    _MAP_POLI_11        = 1Eh,       // **
/*
In the car driver can chouse "Map scale"
10m 20m 100m 200m 500m 1km 2km 5km 10km 50km 100km
cnt=11
*/    
    // string search POI 
    _COUNTRYs           	= 0Ah,
    _CH_country  		= 0Bh,      // fully parsed _CH_IDX_COUNTR= 0Bh
    _CITIEs             = 0Ch,	    // fully parsed
    _CH_cityes    		= 0Dh,      // fully parsed _CH_IDX_= 0Ch
    _ROADs            	= 0Eh,		//
    _CH_road     		= 0Fh,      // fully parsed _CH_IDX_= 0Eh
    _POIs                = 10h,		// fully parsed
    _CH_poi       		= 11h,  	// fully parsed ?_CH_arrPTR_COUNTR= 0Bh

    _ABSTRACT		  	= 12h,
    _FILE_INFO           = 13h,		// fully parsed

    _TERR_DIVISION      = 17h,       // from 0x07 any countries
    _IDX_TERR_DIVISION  = 18h, 

    _CARINET_TOC        = 0x66,        //table of contents carinet
    _CARINET_64_second  = 0x64,
    _CARINET_NATIVE_LANG_MESSAGES  = 0x65,    
    
    _invalid            = 252,
    _empty              =  253,
    _unknown            = 254,
    _too_far            = 255
} en_BL_DATA_TYPE <format=hex, fgcolor=cYellow, bgcolor=cLtBlue>;

//en_CARINET_LANGUAGE 
typedef enum <uchar>{
	_Nederlands =   1,		//01 (1) 	 nederland, belgie - Dutch 
	_English    =   2,  	//02 (2) 	 united kingdom, eire
	_French     =   3,  	//03 (3) 	 france, luxembourg
	_Deutch     =   4,  	//04 (4) 	 deutschland oesterreich osterreich schweiz
	_Italian    =   5,  	//05 (5) 	 italia
	_Hispain    =   6,  	//06 (6) 	 espana
	_Svedian    =   7,  	//07 (7) 	 sverige
	__unk_08	=	8,
	__unk_09	=	9,
	_Danian 	=   0xA, 	//0A (10) 	 danmark
	_Catalan 	=   0xB, 	//0B (11) 	 andorra
	_Finnish    =   0xC, 	//0C (12) 	 suomen tasavalta
	__unk_0d	=	0xd,
	_Norvegian  =   0xE, 	//0E (14) 	 norge    
	_Portugal   =   0xF, 	//0F (15) 	 portugal  //07FF: (nenhuma mensagem)  
	__unk_10	=	0x10,		// _english_TOO
	__eng_TOO   =   0x11,
	_Polish     =   0x12, 	//12 (18) 	 polska
	_Czech      =   0x13, 	//13 (19) 	 ceska republika
	_Slovak     =   0x14, 	//14 (20) 	 slovenska republika
	_Croatian	=	0x1A,	//1A (26) 	 hrvatska
	_Latvian	=	0x1B,	//1B (27) 	 latvija
	_Lithuanian	=	0x18,	//18 (24) 	 lietuva
	_Slovene	=	0x17,	//17 (23) 	 slovenija
	_UNK_lng  = 0xFF
}en_CARINET_LANGUAGE  <bgcolor=cGreen, fgcolor=cDkGreen>; // 0x66 0x65 0x64




//{en_PLACE_CATEGORY	 0xA 0xC blocks
