// used in  0x0A, 10 file
//en_GEO_TYPE
typedef enum <uchar>{
    place   = 0x00,
    point   = 0x01,     //or building ect []0A - use 1 as altername
    village = 0x10,
    __strange = 0xff
    
}en_GEO_TYPE <bgcolor=0xFF8080, fgcolor=cAqua>;


// used in 0x0B file, __place
//  type=1 - str - get interface str list for choice 
//  type=0 - chrs - get keyboard with list accesible chars - char idx ( 0Dh,
typedef enum <byte>{
    user_intrf_keyboard   = 0,
    user_intrf_str_list   = 1
}en_interface_choice_type <bgcolor=0xFF8080, fgcolor=cAqua>;

