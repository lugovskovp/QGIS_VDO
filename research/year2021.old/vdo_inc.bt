// --- UNKN            unknown DWORD - red color <format=hex, fgcolor=0x0000fa>;
//<bgcolor=0x0050c0, fgcolor=0xfafafa>;
typedef struct{
//    SetForeColor (cDkGreen);fgcolor=0x0000fa
    DWORD   x <format=hex, fgcolor=cDkRed, bgcolor=cLtRed>;
}UNKN;
typedef struct{
    WORD   x <format=hex, fgcolor=cDkRed, bgcolor=cLtRed>;
}UNKNw;

typedef struct{
    DWORD zero <hidden=true, fgcolor=cLtGray>;
    if(zero){
        FSeek(FTell()-4);
        DWORD zero <bgcolor=cRed>;
    }
}ZERO_DWORD;
typedef struct{
    WORD zero <hidden=true, fgcolor=cLtGray>;
    if(zero){
        FSeek(FTell()-2);
        WORD zero <bgcolor=cRed>;
    }
}ZERO_WORD;


typedef struct (DWORD cnst){
    local DWORD check = ReadUInt(FTell());
    local DWORD cnstant <hidden=true> = cnst ;
    if(check == cnst){
        DWORD value <hidden=true, bgcolor=cLtAqua, fgcolor=cBlue>;
    }else{
        DWORD value <bgcolor=cRed>;
    }
}CONST_DWORD <read=Read_CONST_DWORD>;
typedef struct (WORD cnst){
    local WORD check = ReadUShort(FTell());
    local WORD cnstant <hidden=true> = cnst ;
    if(check == cnst){
        WORD value <hidden=true, bgcolor=cLtAqua, fgcolor=cBlue>;
    }else{
        WORD value <bgcolor=cRed>;
    }
}CONST_WORD;
string Read_CONST_DWORD(CONST_DWORD &a){
    local string s;
    SPrintf(s, "const = 0x%02X %i ; val = 0x%02X %i ", 
            a.cnstant, a.cnstant, a.value, a.value);
    return s;
}
string Read_CONST_WORD(CONST_WORD &a){
    local string s;
    SPrintf(s, "const = 0x%02X %i ; val = 0x%02X %i ", 
            a.cnstant, a.cnstant, a.value, a.value);
    return s;
}

